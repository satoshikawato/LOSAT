Seq-annot ::= {
  desc {
    user {
      type str "Hist Seqalign",
      data {
        {
          label str "Hist Seqalign",
          data bool TRUE
        }
      }
    },
    user {
      type str "Blast Type",
      data {
        {
          label str "blastn",
          data int 1
        }
      }
    },
    user {
      type str "Blast Database Title",
      data {
        {
          label str "nord_v5 (parsed Seq-ids)",
          data bool TRUE
        }
      }
    }
  },
  data align {
    {
      type partial,
      dim 2,
      score {
        {
          id str "score",
          value int 660
        },
        {
          id str "blast_score",
          value int 660
        },
        {
          id str "e_value",
          value real { 0, 10, 0 }
        },
        {
          id str "bit_score",
          value real { 121990906477671, 10, -11 }
        },
        {
          id str "num_ident",
          value int 660
        },
        {
          id str "hsp_percent_coverage",
          value real { 1, 10, 2 }
        }
      },
      segs denseg {
        dim 2,
        numseg 1,
        ids {
          local str "Query_1",
          general {
            db "BL_ORD_ID",
            tag id 3
          }
        },
        starts {
          0,
          0
        },
        lens {
          660
        },
        strands {
          plus,
          plus
        }
      }
    }
  }
}
