Blast-def-line-set ::= {
  {
    title "first defline without a gi",
    seqid {
      other {
        accession "XP_900001",
        version 1
      }
    },
    taxid 0
  },
  {
    title "second defline with a gi",
    seqid {
      gi 9002,
      embl {
        accession "CAA90002",
        version 1
      }
    },
    taxid 0
  },
  {
    title "third defline swissprot",
    seqid {
      swissprot {
        name "NAME3_HUMAN",
        accession "P90003",
        release "reviewed",
        version 1
      }
    },
    taxid 0
  }
}
