Blast-db-mask-info ::= {
  algo-id 2,
  algo-program dust,
  algo-options "edge word",
  masks {
    masks {
      packed-int {
        {
          from 1,
          to 2,
          id local id 1
        }
      },
      packed-int {
        {
          from 2,
          to 3,
          id local id 2
        }
      },
      packed-int {
        {
          from 3,
          to 4,
          id local id 3
        }
      },
      packed-int {
        {
          from 3,
          to 5,
          id local id 4
        }
      }
    },
    more FALSE
  }
}
