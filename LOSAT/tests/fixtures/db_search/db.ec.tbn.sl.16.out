<?xml version="1.0" encoding="US-ASCII"?>
<BlastXML2
    xmlns="http://www.ncbi.nlm.nih.gov"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
    xs:schemaLocation="http://www.ncbi.nlm.nih.gov http://www.ncbi.nlm.nih.gov/data_specs/schema_alt/NCBI_BlastOutput2.xsd"
>
<BlastOutput2>
  <report>
    <Report>
      <program>tblastn</program>
      <version>TBLASTN 2.17.0+</version>
      <reference>Stephen F. Altschul, Thomas L. Madden, Alejandro A. Sch&amp;auml;ffer, Jinghui Zhang, Zheng Zhang, Webb Miller, and David J. Lipman (1997), &quot;Gapped BLAST and PSI-BLAST: a new generation of protein database search programs&quot;, Nucleic Acids Res. 25:3389-3402.</reference>
      <search-target>
        <Target>
          <db>tests/db_search/taxfilter/tfn</db>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <matrix>BLOSUM62</matrix>
          <expect>10</expect>
          <gap-open>11</gap-open>
          <gap-extend>1</gap-extend>
          <filter>L;</filter>
          <cbs>2</cbs>
          <db-gencode>1</db-gencode>
        </Parameters>
      </params>
      <results>
        <Results>
          <search>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>first protein query with a title long enough to be cut</query-title>
              <query-len>142</query-len>
              <hits></hits>
              <stat>
                <Statistics>
                  <db-num>16</db-num>
                  <db-len>10937</db-len>
                  <hsp-len>18</hsp-len>
                  <eff-space>21576</eff-space>
                  <kappa>0.041</kappa>
                  <lambda>0.267</lambda>
                  <entropy>0.14</entropy>
                </Statistics>
              </stat>
              <message>Query_1 first protein que.. :  Query_1 first protein que.. : Filtering resulted in an empty database.  No hits found</message>
            </Search>
          </search>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>

<BlastOutput2>
  <report>
    <Report>
      <program>tblastn</program>
      <version>TBLASTN 2.17.0+</version>
      <reference>Stephen F. Altschul, Thomas L. Madden, Alejandro A. Sch&amp;auml;ffer, Jinghui Zhang, Zheng Zhang, Webb Miller, and David J. Lipman (1997), &quot;Gapped BLAST and PSI-BLAST: a new generation of protein database search programs&quot;, Nucleic Acids Res. 25:3389-3402.</reference>
      <search-target>
        <Target>
          <db>tests/db_search/taxfilter/tfn</db>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <matrix>BLOSUM62</matrix>
          <expect>10</expect>
          <gap-open>11</gap-open>
          <gap-extend>1</gap-extend>
          <filter>L;</filter>
          <cbs>2</cbs>
          <db-gencode>1</db-gencode>
        </Parameters>
      </params>
      <results>
        <Results>
          <search>
            <Search>
              <query-id>Query_2</query-id>
              <query-title>second</query-title>
              <query-len>147</query-len>
              <hits></hits>
              <stat>
                <Statistics>
                  <db-num>16</db-num>
                  <db-len>10937</db-len>
                  <hsp-len>18</hsp-len>
                  <eff-space>22446</eff-space>
                  <kappa>0.041</kappa>
                  <lambda>0.267</lambda>
                  <entropy>0.14</entropy>
                </Statistics>
              </stat>
              <message>Query_2 second:  Query_2 second: Filtering resulted in an empty database.  No hits found</message>
            </Search>
          </search>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>
</BlastXML2>
