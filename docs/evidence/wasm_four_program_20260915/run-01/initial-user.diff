+            // NCBI reference: /mnt/c/Users/genom/GitHub/ncbi-blast/c++/src/algo/blast/core/link_hsps.c:901-982
+            // ```c
+            // prob[0] = BLAST_SmallGapSumE(...);
+            // prob[1] = BLAST_LargeGapSumE(...);
