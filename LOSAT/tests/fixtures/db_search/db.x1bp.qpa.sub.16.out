<BlastOutput2>
  <report>
    <Report>
      <program>blastn</program>
      <version>BLASTN 2.17.0+</version>
      <reference>Stephen F. Altschul, Thomas L. Madden, Alejandro A. Sch&amp;auml;ffer, Jinghui Zhang, Zheng Zhang, Webb Miller, and David J. Lipman (1997), &quot;Gapped BLAST and PSI-BLAST: a new generation of protein database search programs&quot;, Nucleic Acids Res. 25:3389-3402.</reference>
      <search-target>
        <Target>
          <subjects>Subject_1</subjects>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <expect>10</expect>
          <sc-match>2</sc-match>
          <sc-mismatch>-3</sc-mismatch>
          <filter>L;m;</filter>
        </Parameters>
      </params>
      <results>
        <Results>
          <bl2seq>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>qA</query-title>
              <query-len>15</query-len>
              <hits></hits>
              <stat>
                <Statistics>
                  <hsp-len>4</hsp-len>
                  <eff-space>1485</eff-space>
                  <kappa>0.408145662544724</kappa>
                  <lambda>0.633731443099174</lambda>
                  <entropy>0.91243839227971</entropy>
                </Statistics>
              </stat>
              <message>No hits found</message>
            </Search>
          </bl2seq>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>

