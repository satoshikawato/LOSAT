          value boolean FALSE
        }
      }
    }
  },
  results {
    alignments {
    },
    masks {
    },
    ka-blocks {
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped FALSE
      },
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped TRUE
      }
    },
    search-stats {
