Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "plain",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">q1 one\303\251"
                  }
                }
              },
              title "q1 one##"
            },
            inst {
              repr raw,
              mol aa,
              length 60,
              seq-data ncbieaa "MDIVWSTFSARIQFAQYVPPKIIRFTWHNHPSLEGWNGRQFYDIGE
NTGMFRLGFPKFIG"
            }
          }
        }
      },
      subject database "tests/db_search/arch_sprot",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "WordThreshold",
          value integer 11
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "UngappedMode",
          value boolean FALSE
        },
        {
          name "CompositionBasedStats",
          value integer 2
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 11891
        }
      }
    }
  },
  results {
    alignments {
      {
        type partial,
        dim 2,
        score {
          {
            id str "score",
            value int 20
          },
          {
            id str "blast_score",
            value int 20
          },
          {
            id str "e_value",
            value real { 245074638897069, 10, -14 }
          },
          {
            id str "bit_score",
            value real { 123122237983911, 10, -13 }
          },
          {
            id str "num_ident",
            value int 8
          },
          {
            id str "comp_adjustment_method",
            value int 2
          },
          {
            id str "num_positives",
            value int 19
          },
          {
            id str "hsp_percent_coverage",
            value real { 638333333333333, 10, -13 }
          }
        },
        segs denseg {
          dim 2,
          numseg 3,
          ids {
            local str "Query_1",
            general {
              db "BL_ORD_ID",
              tag id 0
            }
          },
          starts {
            19,
            27,
            -1,
            38,
            30,
            40
          },
          lens {
            11,
            2,
            27
          },
          strands {
            unknown,
            unknown,
            unknown,
            unknown,
            unknown,
            unknown
          }
        }
      }
    },
    masks {
    },
    ka-blocks {
      {
        lambda { 328359279567946, 10, -15 },
        k { 144910240972546, 10, -15 },
        h { 509847547870379, 10, -15 },
        gapped FALSE
      },
      {
        lambda { 267, 10, -3 },
        k { 41, 10, -3 },
        h { 14, 10, -2 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 11891",
      "Effective search space used: 11891",
      "Length adjustment: 13"
    }
  },
  messages {
    {
      code 2,
      message "Error: (803.7) [blastp]
 Blast4-request.body.queue-search.queries.bioseq-set.seq-set.E.seq.descr.E.tit
le Bad char [0xC3] in string at line 21 q1 one"
    },
    {
      code 2,
      message "Error: (803.7) [blastp]
 Blast4-request.body.queue-search.queries.bioseq-set.seq-set.E.seq.descr.E.tit
le Bad char [0xA9] in string at line 21 q1 one"
    }
  }
}
