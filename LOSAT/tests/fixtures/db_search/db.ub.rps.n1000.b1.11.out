Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "rpsblast",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">x1"
                  }
                }
              },
              title "x1"
            },
            inst {
              repr raw,
              mol aa,
              length 20,
              seq-data ncbieaa "XXXXXXXXXXXXXXXXXXXX"
            }
          }
        }
      },
      subject database "n1000rps",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "CompositionBasedStats",
          value integer 0
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        },
        {
          name "MatrixName",
          value string "BLOSUM62"
        },
        {
          name "GapOpeningCost",
          value integer 11
        },
        {
          name "GapExtensionCost",
          value integer 1
        }
      }
    }
  },
  results {
    alignments {
    },
    masks {
    },
    ka-blocks {
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped FALSE
      },
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 0",
      "Effective search space used: 0",
      "Length adjustment: 0"
    }
  }
}
