              db "BL_ORD_ID",
              tag id 0
            }
          },
          starts {
            4294966594,
            464
          },
          len 300,
          strands {
            minus,
            plus
          },
          scores {
            {
              id str "score",
              value int 300
            },
            {
              id str "blast_score",
              value int 300
            },
            {
              id str "e_value",
              value real { 248257842246944, 10, -184 }
            },
            {
              id str "bit_score",
              value real { 577493753959806, 10, -12 }
            },
            {
              id str "num_ident",
              value int 300
            },
            {
              id str "hsp_percent_coverage",
