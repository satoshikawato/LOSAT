-        return (0, 0, 0.0);
-    };
-    if samples.is_empty() {
-        return (0, 0, 0.0);
-    }
-    let mut sorted = samples.clone();
-    sorted.sort_unstable();
-    let count = sorted.len();
-    let max = sorted[count - 1];
-    let median = if count % 2 == 0 {
-        let upper = sorted[count / 2] as f64;
-        let lower = sorted[(count / 2) - 1] as f64;
-        (lower + upper) / 2.0
-    } else {
-        sorted[count / 2] as f64
-    };
-    (count, max, median)
