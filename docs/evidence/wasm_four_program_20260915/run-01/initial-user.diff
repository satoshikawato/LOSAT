+/// Unpack a base from NCBI2NA packed byte.
+/// NCBI reference: ncbi-blast/c++/src/algo/blast/core/greedy_align.c:365-369 (NCBI2NA_UNPACK_BASE usage)
+#[inline]
+fn ncbi2na_unpack_base(byte: u8, pos: u8) -> u8 {
+    (byte >> (pos * 2)) & 0x03
+}
