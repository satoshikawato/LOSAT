Seq-entry ::= set {
  seq-set {
    seq {
      id { local str "t1" },
      descr { title "explicit title." },
      inst { repr raw, mol dna, length 4,
        seq-data iupacna "ACGT" }
    },
    seq {
      id { local str "t2" },
      descr { source { org { taxname "Homo sapiens", db { { db "taxon", tag id 9606 } } } } },
      inst { repr raw, mol dna,
        length 4, seq-data iupacna "ACGT" }
    },
    seq {
      id { local str "t3" },
      descr { title "a &amp; b ;;  " },
      inst { repr raw,
        mol dna, length 4, seq-data iupacna "ACGT" }
    },
    seq {
      id { local str "t5" },
      descr { title "two titles A", title "two titles B" },
      inst {
        repr raw, mol dna, length 4, seq-data iupacna "ACGT" }
    },
    seq {
      id { local str "t7" },
      inst { repr raw, mol dna, length 4, seq-data
        iupacna "ACGT" }
    }
  }
}
