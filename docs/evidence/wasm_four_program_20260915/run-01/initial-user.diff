+    pub fn update(&mut self, mut hsp_list: BlastnHspList) {
+        update_best_evalue(&mut hsp_list);
+
+        if self.hsplist_count < self.hsplist_max {
+            if self.hsplist_current == self.hsplist_count && !self.grow_hsplist_array() {
+                return;
