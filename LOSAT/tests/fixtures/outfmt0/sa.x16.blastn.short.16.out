                      <num>1</num>
                      <bit-score>1090.79</bit-score>
                      <score>550</score>
                      <evalue>0</evalue>
                      <identity>550</identity>
                      <query-from>101</query-from>
                      <query-to>650</query-to>
                      <query-strand>Plus</query-strand>
                      <hit-from>101</hit-from>
                      <hit-to>650</hit-to>
                      <hit-strand>Plus</hit-strand>
                      <align-len>550</align-len>
                      <gaps>0</gaps>
                      <qseq></qseq>
                      <hseq></hseq>
                      <midline>||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||</midline>
                    </Hsp>
