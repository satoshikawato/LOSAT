        seq { id { local str "m4a" }, inst { repr seg, mol dna, length 60, seq-data iupacna "GCTAAAGACAATTACATAACATACACGTCAGCACGAAACTTGTTGGCCCAGTGTGAATCG", ext seg { whole local str "sp4a" } } },
