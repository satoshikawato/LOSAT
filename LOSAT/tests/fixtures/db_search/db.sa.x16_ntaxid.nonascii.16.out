              <hits></hits>
              <stat>
                <Statistics>
                  <db-num>2</db-num>
                  <db-len>965</db-len>
                  <hsp-len>10</hsp-len>
                  <eff-space>75600</eff-space>
                  <kappa>0.46</kappa>
