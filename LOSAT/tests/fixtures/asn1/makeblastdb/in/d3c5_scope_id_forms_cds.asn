          inst { repr raw, mol aa, length 10, seq-data ncbieaa "MKKKKKKKKK" },
          annot { { data ftable {
            { data prot { name { "probe protein 100" } }, location whole genbank { accession "BAA00100", version 1 } }
          } } }
        }
      }
    },
