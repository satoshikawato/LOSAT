+            let s_end = s_off as i32 + s_ext_r;
+            let debug_traceback = debug_greedy_traceback_enabled(q_off, s_off);
+            if debug_traceback {
+                // NCBI reference: /mnt/c/Users/genom/GitHub/ncbi-blast/c++/src/algo/blast/core/blast_gapalign.c:2876-2882
