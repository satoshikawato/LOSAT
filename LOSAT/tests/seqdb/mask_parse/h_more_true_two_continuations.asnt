Blast-db-mask-info ::= { algo-id 0, algo-program windowmasker, algo-options "x", masks { masks { packed-int { { from 5, to 14,  id local id 3 } } }, more TRUE } }
Blast-mask-list ::= { masks { packed-int { { from 20, to 29,  id local id 4 } } }, more TRUE }
Blast-mask-list ::= { masks { int { from 1, to 3,  id local id 5 } }, more FALSE }
