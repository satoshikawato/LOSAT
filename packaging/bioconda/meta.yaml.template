{% set name = "losat" %}
{% set version = "0.1.0" %}

package:
  name: {{ name }}
  version: {{ version }}

source:
  url: https://github.com/satoshikawato/LOSAT/archive/refs/tags/v{{ version }}.tar.gz
  sha256: __REPLACE_WITH_V0_1_0_TAG_TARBALL_SHA256__

build:
  number: 0

requirements:
  build:
    - {{ compiler('rust') }}
    - cargo-bundle-licenses

test:
  commands:
    - LOSAT --version
    - LOSAT --help
    - LOSAT blastn --help
    - LOSAT blastp --help
    - LOSAT tblastx --help

about:
  home: https://github.com/satoshikawato/LOSAT
  license: MIT
  license_family: MIT
  license_file:
    - LICENSE
    - THIRDPARTY.yml
  summary: Pure-Rust pairwise sequence alignment with bit-perfect NCBI BLAST+ parity
  description: |
    LOSAT is a standalone, pure-Rust implementation of NCBI BLAST+ local sequence
    alignment designed for pairwise FASTA comparisons (-query vs -subject). It
    provides drop-in CLI compatibility and bit-identical output (E-values, bit
    scores, and coordinates) for BLASTN (including MegaBLAST), BLASTP, and
    TBLASTX without requiring pre-formatted databases or external C/C++ runtimes.
  dev_url: https://github.com/satoshikawato/LOSAT
  doc_url: https://github.com/satoshikawato/LOSAT/blob/v{{ version }}/README.md

extra:
  additional-platforms:
    - linux-aarch64
    - osx-arm64
  recipe-maintainers:
    - satoshikawato
