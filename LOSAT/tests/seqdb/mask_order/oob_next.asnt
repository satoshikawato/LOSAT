Blast-db-mask-info ::= {
  algo-id 0,
  algo-program windowmasker,
  algo-options "",
  masks {
    masks {
      int { from 10, to 40, strand plus, id gi 5 },
      int { from 50, to 60, strand plus, id genbank { accession "AY000005", version 1 } },
      int { from 150, to 900, id local str "other" }
    },
    more FALSE
  }
}
