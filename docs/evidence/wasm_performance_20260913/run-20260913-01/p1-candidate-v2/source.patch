 #[cfg(test)]
 mod tests {
+    // NCBI reference: c++/src/algo/blast/core/link_hsps.c:710-746
+    // if(q_off_t > (H_q_et_gap+trim_size)) break;
+    // if (b1|b2|b5|b4) continue;
+    // if (sum>H_hsp_sum) { H2=lh_helper[H2_index].ptr; ... }
+    #[test]
+    fn small_gap_predecessor_preserves_ties_and_window_boundaries() {
+        let link = HspLink {
+            score: 10, ctx_idx: 0, q_off_trim: 0, s_off_trim: 0,
+            q_end_trim: 0, s_end_trim: 0, sum: [9, 0], xsum: [0.125, 0.0],
+            num: [2, 0], link: [SENTINEL_IDX; 2], changed: false, linked_to: 0,
+            start_of_chain: false, linked_set: false,
+            next_active: SENTINEL_IDX, prev_active: SENTINEL_IDX,
+        };
+        let helper = LhHelper { hsp_idx: 0, q_off_trim: 11, s_off_trim: 11,
+            sum: [9, 0], next_larger: 0, maxsum1: 0 };
+        let links = [link.clone(), link];
+        let mut helpers = vec![helper; 4];
+        helpers[3].hsp_idx = 1;
+        let scan = |helpers: &[LhHelper], count| small_gap_predecessor(count, [10, 10], helpers, &links, &[], false);
+        assert_eq!(scan(&helpers, 2), (0, 0.0, 0, SENTINEL_IDX));
+        // A strict score comparison retains the first predecessor in reverse order.
+        assert_eq!(scan(&helpers, 4), (9, 0.125, 2, 1));
+        for (q, subject, selected) in [
+            (10, 11, 0), (11, 10, 0),
+            (10 + WINDOW_SIZE, 10 + WINDOW_SIZE, 1),
+            (10 + WINDOW_SIZE + 1, 11, 0),
+            (11, 10 + WINDOW_SIZE + 1, 0),
+        ] {
+            helpers[3].q_off_trim = q; helpers[3].s_off_trim = subject;
+            assert_eq!(scan(&helpers, 4).3, selected, "q={q} subject={subject}");
+        }
+        helpers[3].q_off_trim = 10 + WINDOW_SIZE + TRIM_SIZE + 1;
+        helpers[3].s_off_trim = 11;
+        assert_eq!(scan(&helpers, 4), (0, 0.0, 0, SENTINEL_IDX));
+    }
