+            .map_err(engine_error)
+        }
+        "blastn" => blastn::run_web_pair(
+            parse_blastn_args(
+                &extra,
+                std::path::PathBuf::new(),
+                std::path::PathBuf::new(),
+                std::path::PathBuf::new(),
+            )?,
+            query_fasta,
+            subject_fasta,
+        )
+        .map_err(engine_error),
+        "tblastx" => tblastx::run_web_pair(
+            parse_tblastx_args(
+                &extra,
+                std::path::PathBuf::new(),
+                std::path::PathBuf::new(),
+                std::path::PathBuf::new(),
