Blast-db-mask-info ::= {
  algo-id 2,
  algo-program seg,
  algo-options "edge tiny",
  masks {
    masks {
      packed-int {
        {
          from 101,
          to 101,
          id local id 5
        },
        {
          from 104,
          to 104,
          id local id 5
        },
        {
          from 200,
          to 201,
          id local id 5
        }
      }
    },
    more FALSE
  }
}
