Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "psi",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">q0"
                  }
                }
              },
              title "q0"
            },
            inst {
              repr raw,
              mol aa,
              length 100,
              seq-data ncbieaa "TIPYCCPAGQSSINLPTKTSLMFPTNYQYIVKWISHYPKCERNRGG
VLPKGVWFQWHRDWMMQFRYWNNQAPHQGFKQELEPGSLHRIGPFGFWSMDEYQ"
            }
          }
        }
      },
      subject database "tests/db_search/idlist/g",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, -10 }
        },
        {
          name "InclusionThreshold",
          value real { 2, 10, -3 }
        },
        {
          name "PseudoCountWeight",
          value integer 0
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "WordThreshold",
          value integer 11
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "CompositionBasedStats",
          value integer 2
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        },
        {
          name "GapTrigger",
          value real { 22, 10, 0 }
        },
        {
          name "IgnoreMsaMaster",
          value boolean FALSE
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 24624
        }
      },
      program-options {
        {
          name "GiList",
          value big-integer-list {
            102,
            102,
            108,
            117
          }
        },
        {
          name "TaxidList",
          value integer-list {
          }
        }
      },
      format-options {
        {
          name "Web_StepNumber",
          value integer 1
        }
      }
    }
  },
  results {
    alignments {
      {
        type partial,
        dim 2,
        score {
          {
            id str "score",
            value int 544
          },
          {
            id str "blast_score",
            value int 544
          },
          {
            id str "e_value",
            value real { 28622507823447, 10, -91 }
          },
          {
            id str "bit_score",
            value real { 214156801579084, 10, -12 }
          },
          {
            id str "num_ident",
            value int 100
          },
          {
            id str "comp_adjustment_method",
            value int 2
          },
          {
            id str "num_positives",
            value int 100
          },
          {
            id str "hsp_percent_coverage",
            value real { 1, 10, 2 }
          }
        },
        segs denseg {
          dim 2,
          numseg 1,
          ids {
            local str "Query_1",
            gi 102
          },
          starts {
            0,
            0
          },
          lens {
            100
          },
          strands {
            unknown,
            unknown
          }
        },
        ext {
          {
            type str "use_this_seqid",
            data {
              {
                label str "SEQIDS",
                num 1,
                data strs {
                  "gi:102"
                }
              }
            }
          }
        }
      }
    },
    masks {
    },
    ka-blocks {
      {
        lambda { 323611627204224, 10, -15 },
        k { 139667698131006, 10, -15 },
        h { 5133818303542, 10, -13 },
        gapped FALSE
      },
      {
        lambda { 267, 10, -3 },
        k { 41, 10, -3 },
