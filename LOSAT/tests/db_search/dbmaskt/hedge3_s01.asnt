Blast-db-mask-info ::= {
  algo-id 2,
  algo-program windowmasker,
  algo-options "hedge3 s01",
  masks {
    masks {
      packed-int {
        {
          from 0,
          to 0,
          id local id 3
        },
        {
          from 600,
          to 699,
          id local id 3
        }
      }
    },
    more FALSE
  }
}
