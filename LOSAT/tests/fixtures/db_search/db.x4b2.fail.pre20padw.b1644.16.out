                <Range>
                  <from>4</from>
                  <to>55</to>
                </Range>
              </query-masking>
              <hits>
                <Hit>
                  <num>1</num>
                  <description>
                    <HitDescr>
                      <id>sok1</id>
                      <title>sok1 BDT63546.1 of PajaWSV</title>
                    </HitDescr>
                  </description>
                  <len>124</len>
                  <hsps>
                    <Hsp>
                      <num>1</num>
                      <bit-score>40.4318</bit-score>
                      <score>93</score>
                      <evalue>7.02968e-10</evalue>
                      <identity>19</identity>
                      <positive>19</positive>
                      <query-from>1</query-from>
                      <query-to>60</query-to>
                      <query-frame>1</query-frame>
                      <hit-from>1</hit-from>
                      <hit-to>20</hit-to>
                      <align-len>20</align-len>
                      <gaps>0</gaps>
                      <qseq>WATAPAALPFGKANAAACGN</qseq>
                      <hseq>MATAPAALPFGKANAAACGN</hseq>
                      <midline> ATAPAALPFGKANAAACGN</midline>
                    </Hsp>
                  </hsps>
                </Hit>
              </hits>
              <stat>
                <Statistics>
                  <hsp-len>0</hsp-len>
                  <eff-space>1000</eff-space>
                  <kappa>0.041</kappa>
                  <lambda>0.267</lambda>
                  <entropy>0.14</entropy>
