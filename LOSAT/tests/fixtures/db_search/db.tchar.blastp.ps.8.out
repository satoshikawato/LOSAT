Seq-annot ::= {
  desc {
    user {
      type str "Hist Seqalign",
      data {
        {
          label str "Hist Seqalign",
          data bool TRUE
        }
      }
    },
    user {
      type str "Blast Type",
      data {
        {
          label str "blastp",
          data int 2
        }
      }
    },
    user {
      type str "Blast Database Title",
      data {
        {
          label str "tc_ps_p",
          data bool FALSE
        }
      }
    }
  },
  data align {
    {
      type partial,
      dim 2,
      score {
        {
          id str "score",
          value int 320
        },
        {
          id str "blast_score",
          value int 320
        },
        {
          id str "e_value",
          value real { 377175112028326, 10, -60 }
        },
        {
          id str "bit_score",
          value real { 127872096573597, 10, -12 }
        },
        {
          id str "num_ident",
          value int 60
        },
        {
          id str "comp_adjustment_method",
          value int 2
        },
        {
          id str "num_positives",
          value int 60
        },
        {
          id str "hsp_percent_coverage",
          value real { 1, 10, 2 }
        }
      },
      segs denseg {
        dim 2,
        numseg 1,
        ids {
          local str "Query_1",
          local str "ps1"
        },
        starts {
          0,
          0
        },
        lens {
          60
        },
        strands {
          unknown,
          unknown
        }
      }
    }
  }
}
