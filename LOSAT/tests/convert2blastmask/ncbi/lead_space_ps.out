Blast-db-mask-info ::= {
  algo-id 0,
  algo-program dust,
  algo-options "o",
  masks {
    masks {
      packed-int {
        {
          from 12,
          to 13,
          id local str "a"
        },
        {
          from 0,
          to 3,
          id local str "a"
        }
      }
    },
    more FALSE
  }
}
