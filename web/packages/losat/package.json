{
  "name": "losat",
  "version": "0.2.0",
  "private": true,
  "description": "LOSAT's local sequence search in the browser: the host of its two WebAssembly reactors (ABI v2).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satoshikawato/LOSAT.git",
    "directory": "web/packages/losat"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./ports": "./src/ports/index.ts"
  },
  "scripts": {
    "build": "node build/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
