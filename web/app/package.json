{
  "name": "losat-web",
  "version": "0.0.0",
  "private": true,
  "description": "LOSAT Web: in-browser local sequence search (see docs/losat_web_gui_plan.md).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  }
}
