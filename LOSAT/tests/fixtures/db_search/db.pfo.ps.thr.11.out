Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "psi",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">qN"
                  }
                }
              },
              title "qN"
            },
            inst {
              repr raw,
              mol aa,
              length 30,
              seq-data ncbieaa "WWWWWWWWWWHHHHHHHHHHWWWWWWWWWW"
            }
          }
        }
      },
      subject database "tests/db_search/idlist/pw",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, -10 }
        },
        {
          name "InclusionThreshold",
          value real { 2, 10, -3 }
        },
        {
          name "PseudoCountWeight",
          value integer 0
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "WordThreshold",
          value integer 11
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "CompositionBasedStats",
          value integer 2
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        },
        {
          name "GapTrigger",
          value real { 22, 10, 0 }
        },
        {
          name "IgnoreMsaMaster",
          value boolean FALSE
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 6723
        }
      },
      format-options {
        {
          name "Web_StepNumber",
          value integer 1
        }
      }
    }
  },
  results {
    alignments {
    },
    masks {
    },
    ka-blocks {
      {
        lambda { 332180439583108, 10, -15 },
        k { 162748521336836, 10, -15 },
        h { 129470304746879, 10, -14 },
        gapped FALSE
      },
      {
        lambda { 267, 10, -3 },
        k { 41, 10, -3 },
        h { 14, 10, -2 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 6723",
      "Effective search space used: 6723",
      "Length adjustment: 3"
    }
  }
}
