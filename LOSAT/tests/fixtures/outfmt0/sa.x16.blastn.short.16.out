        </Target>
      </search-target>
      <params>
        <Parameters>
          <expect>1e-20</expect>
          <sc-match>1</sc-match>
          <sc-mismatch>-3</sc-mismatch>
          <gap-open>5</gap-open>
          <gap-extend>2</gap-extend>
          <filter>L;m;</filter>
        </Parameters>
      </params>
