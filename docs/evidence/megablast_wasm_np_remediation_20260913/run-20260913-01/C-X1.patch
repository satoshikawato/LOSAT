+                &params,
+                &linking.cutoffs,
+                linking.gap_decay_rate,
+                false,
+                linking.subject_len_nucl,
+                &contexts,
+                &[0; 6],
+                &[0; 12],
+                &[4_000_000; 12],
+                &log_k,
+                &mut helpers,
+                &mut links,
+            );
+            let values: Vec<_> = processed
+                .iter()
+                .map(|h| {
+                    assert_eq!(&**h as *const UngappedHit, addresses[h.link_id]);
+                    assert_ne!(h.e_value, -1.0);
+                    (h.link_id, h.e_value.to_bits())
+                })
+                .collect();
+            drop(processed);
+            for (id, value) in values {
+                assert_eq!(group[id].e_value.to_bits(), value);
+            }
