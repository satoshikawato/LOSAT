Blast-db-mask-info ::= {
  algo-id 2,
  algo-program dust,
  algo-options "edge e0tail",
  masks {
    masks {
      packed-int {
        {
          from 0,
          to 4294967295,
          id local id 5
        },
        {
          from 1000,
          to 1199,
          id local id 5
        }
      }
    },
    more FALSE
  }
}
