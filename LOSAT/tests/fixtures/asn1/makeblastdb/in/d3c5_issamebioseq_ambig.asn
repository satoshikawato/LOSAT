Bioseq-set ::= {
  seq-set {
    seq {
      id { other { accession "NM_000871", version 1 }, gi 900871 },
      descr { molinfo { biomol mRNA }, source { org { taxname "Homo sapiens" } } },
      inst { repr raw, mol rna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
      annot { { data ftable {
        { data gene { locus-tag "LTORF" }, location int { from 0, to 29, id other { accession "NM_000871", version 1 } } },
        { data cdregion { orf TRUE }, location mix { int { from 0, to 29, strand minus, id gi 900871 }, empty other { accession "NM_000871" } } }
      } } }
    },
    seq {
      id { other { accession "NM_000871", version 2 }, gi 9008712 },
      descr { molinfo { biomol mRNA }, source { org { taxname "Homo sapiens" } } },
      inst { repr raw, mol rna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" }
    },
    seq {
      id { other { accession "NM_000872", version 1 }, gi 900872 },
      descr { molinfo { biomol mRNA }, source { org { taxname "Homo sapiens" } } },
      inst { repr raw, mol rna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
      annot { { data ftable {
        { data gene { locus-tag "LTORF" }, location int { from 0, to 29, id other { accession "NM_000872", version 1 } } },
        { data cdregion { orf TRUE }, location mix { int { from 0, to 29, strand minus, id gi 900872 }, empty other { accession "NM_000872" } } }
      } } }
    },
    seq {
      id { other { accession "NM_000872", version 2 }, gi 9008722 },
      descr { molinfo { biomol mRNA }, source { org { taxname "Homo sapiens" } } },
      inst { repr raw, mol rna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
      annot { { data ftable {
        { data gene { locus-tag "LTB2" }, location int { from 0, to 29, id other { accession "NM_000872", version 2 } } }
      } } }
    },
    seq {
      id { other { accession "NM_000873", version 1 }, gi 900873 },
      descr { molinfo { biomol mRNA }, source { org { taxname "Homo sapiens" } } },
      inst { repr raw, mol rna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
      annot { { data ftable {
        { data gene { locus-tag "LTORF" }, location int { from 0, to 29, id other { accession "NM_000873", version 1 } } },
        { data cdregion { orf TRUE }, location mix { int { from 0, to 9, strand minus, id other { accession "NM_000873", version 1 } }, int { from 20, to 29, strand minus, id other { accession "NM_000873" } } } }
      } } }
    },
    seq {
      id { other { accession "NM_000873", version 2 }, gi 9008732 },
      descr { molinfo { biomol mRNA }, source { org { taxname "Homo sapiens" } } },
      inst { repr raw, mol rna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
      annot { { data ftable {
        { data gene { locus-tag "LTB3" }, location int { from 0, to 29, id other { accession "NM_000873", version 2 } } }
      } } }
    }
  }
}
