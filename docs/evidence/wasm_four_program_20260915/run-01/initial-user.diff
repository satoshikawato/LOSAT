+                }
+            }
+            x if x == SCRIPT_GAP_IN_B => {
+                // NCBI reference: blast_gapalign.c:705-709
+                script = next_script & SCRIPT_OP_MASK;
+                if next_script & SCRIPT_EXTEND_GAP_B != 0 {
+                    script = SCRIPT_GAP_IN_B;
+                }
+            }
+            _ => {
+                // NCBI reference: blast_gapalign.c:711-713
+                script = next_script & SCRIPT_OP_MASK;
+            }
+        }
