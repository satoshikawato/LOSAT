Blast-db-mask-info ::= {
  algo-id 0,
  algo-program windowmasker,
  algo-options "-x a:b",
  masks {
    masks {
      packed-int {
          {
            from 0,
            to 9,
            id local id 1
          },
          {
            from 300,
            to 309,
            id local id 1
          }
      },
      packed-int {
          {
            from 10,
            to 19,
            id local id 4
          }
      }
    },
    more FALSE
  }
}
