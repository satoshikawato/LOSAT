Seq-entry ::= set {
  class segset,
  descr { source { org { taxname "Homo sapiens" } }, molinfo { biomol genomic } },
  seq-set {
    seq {
      id { genbank { accession "AB001310", version 1 } },
      inst { repr seg, mol dna, length 30, ext seg { whole genbank { accession "AB001311" } } }
    },
    set {
      class parts,
      seq-set {
        seq {
          id { genbank { accession "AB001311", version 1 } },
          descr { title "part 131" },
          inst { repr raw, mol dna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
          annot { { data ftable {
            { data cdregion { frame one }, location int { from 0, to 29, id genbank { accession "AB001311", version 1 } }, xref { { data prot { name { "segprot 131" } } }, { data gene { locus "SEGG131" } } } }
          } } }
        }
      }
    }
  }
}
