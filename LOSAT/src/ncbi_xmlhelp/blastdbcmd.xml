<?xml version="1.0"?>
<ncbi_application xmlns="ncbi:application"
 xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
 xs:schemaLocation="ncbi:application ncbi_application.xsd"
>
<program type="regular">
<name>blastdbcmd</name>
<version>2.17.0</version>
<description>BLAST database client, version 2.17.0+</description>
<detailed_description></detailed_description>
</program>
<arguments>
<key name="db" type="String" optional="true">
<description>BLAST database name</description>
<group>1</group>
<synopsis>dbname</synopsis>
<default>nr</default>
</key>
<key name="dbtype" type="String" optional="true">
<description>Molecule type stored in BLAST database</description>
<group>1</group>
<synopsis>molecule_type</synopsis>
<constraint>
<description>`guess&apos;, `nucl&apos;, `prot&apos;</description>
<Strings case_sensitive="true">
<value>guess</value>
<value>nucl</value>
<value>prot</value>
</Strings>
</constraint>
<default>guess</default>
</key>
<key name="entry" type="String" optional="true">
<description>Comma-delimited search string(s) of sequence identifiers:&#xa;&#x9;e.g.: 555, AC147927, &apos;gnl|dbname|tag&apos;, or &apos;all&apos; to select all&#xa;&#x9;sequences in the database</description>
<group>2</group>
<synopsis>sequence_identifier</synopsis>
</key>
<key name="entry_batch" type="File_In" optional="true">
<description>Input file for batch processing (Format: one entry per line, seq id &#xa;followed by optional space-delimited specifier(s) [range|strand|mask_algo_id]</description>
<group>2</group>
<synopsis>input_file</synopsis>
</key>
<key name="ipg" type="Integer" optional="true">
<description>IPG to retrieve</description>
<group>2</group>
<synopsis>IPG</synopsis>
<constraint>
<description>&gt;=0</description>
</constraint>
</key>
<key name="ipg_batch" type="File_In" optional="true">
<description>Input file for batch processing (Format: one entry per line, IPG &#xa;followed by optional space-delimited specifier(s) [range|strand|mask_algo_id]</description>
<group>2</group>
<synopsis>input_file</synopsis>
</key>
<key name="line_length" type="Integer" optional="true">
<description>Line length for output</description>
<group>6</group>
<synopsis>number</synopsis>
<constraint>
<description>&gt;=1</description>
</constraint>
<default>80</default>
</key>
<key name="list" type="String" optional="true">
<description>List BLAST databases in the specified directory</description>
<group>7</group>
<synopsis>directory</synopsis>
</key>
<key name="list_outfmt" type="String" optional="true">
<description>Output format for the list option, where the available format specifiers are:&#xa;&#x9;&#x9;%f means the BLAST database absolute file name path&#xa;&#x9;&#x9;%p means the BLAST database molecule type&#xa;&#x9;&#x9;%t means the BLAST database title&#xa;&#x9;&#x9;%d means the date of last update of the BLAST database&#xa;&#x9;&#x9;%l means the number of bases/residues in the BLAST database&#xa;&#x9;&#x9;%n means the number of sequences in the BLAST database&#xa;&#x9;&#x9;%U means the number of bytes used by the BLAST database&#xa;&#x9;&#x9;%v means the BLAST database format version&#xa;&#x9;For every format each line of output will correspond to a BLAST database.&#xa;</description>
<group>7</group>
<synopsis>format</synopsis>
<default>%f %p</default>
</key>
<key name="logfile" type="File_Out" optional="true">
<description>File to which the program log should be redirected</description>
<group>7</group>
<synopsis>File_Name</synopsis>
</key>
<key name="mask_sequence_with" type="String" optional="true">
<description>Produce lower-case masked FASTA using the algorithm ID specified</description>
<group>3</group>
<synopsis>mask_algo_id</synopsis>
</key>
<key name="metadata_output_prefix" type="String" optional="true">
<description>Path prefix for location of database files in metadata</description>
<group>2</group>
</key>
<key name="out" type="File_Out" optional="true">
<description>Output file name</description>
<group>5</group>
<synopsis>output_file</synopsis>
<default>-</default>
</key>
<key name="outfmt" type="String" optional="true">
<description>Output format, where the available format specifiers are:&#xa;&#x9;&#x9;%f means sequence in FASTA format&#xa;&#x9;&#x9;%s means sequence data (without defline)&#xa;&#x9;&#x9;%a means accession&#xa;&#x9;&#x9;%g means gi&#xa;&#x9;&#x9;%o means ordinal id (OID)&#xa;&#x9;&#x9;%i means sequence id&#xa;&#x9;&#x9;%t means sequence title&#xa;&#x9;&#x9;%l means sequence length&#xa;&#x9;&#x9;%h means sequence hash value&#xa;&#x9;&#x9;%T means taxid&#xa;&#x9;&#x9;%X means leaf-node taxids&#xa;&#x9;&#x9;%e means membership integer&#xa;&#x9;&#x9;%L means common taxonomic name&#xa;&#x9;&#x9;%C means common taxonomic names for leaf-node taxids&#xa;&#x9;&#x9;%S means scientific name&#xa;&#x9;&#x9;%N means scientific names for leaf-node taxids&#xa;&#x9;&#x9;%B means BLAST name&#xa;&#x9;&#x9;%K means taxonomic super kingdom&#xa;&#x9;&#x9;%P means PIG&#xa;&#x9;&#x9;%m means sequence masking data.&#xa;&#x9;&#x9;   Masking data will be displayed as a series of &apos;N-M&apos; values&#xa;&#x9;&#x9;   separated by &apos;;&apos; or the word &apos;none&apos; if none are available.&#xa;&#x9;If &apos;%f&apos; is specified, all other format specifiers are ignored.&#xa;&#x9;For every format except &apos;%f&apos;, each line of output will correspond&#xa;&#x9;to a sequence.&#xa;</description>
<group>5</group>
<synopsis>format</synopsis>
<default>%f</default>
</key>
<key name="range" type="String" optional="true">
<description>Range of sequence to extract in 1-based offsets (Format: start-stop, for start to end of sequence use start - )</description>
<group>3</group>
<synopsis>numbers</synopsis>
</key>
<key name="strand" type="String" optional="true">
<description>Strand of nucleotide sequence to extract</description>
<group>3</group>
<synopsis>strand</synopsis>
<constraint>
<description>`minus&apos;, `plus&apos;</description>
<Strings case_sensitive="true">
<value>minus</value>
<value>plus</value>
</Strings>
</constraint>
<default>plus</default>
</key>
<key name="taxidlist" type="File_In" optional="true">
<description>Input file for taxonomy identifiers</description>
<group>4</group>
<synopsis>input_file</synopsis>
</key>
<key name="taxids" type="String" optional="true">
<description>Comma-delimited taxonomy identifiers</description>
<group>4</group>
<synopsis>taxonomy_ids</synopsis>
</key>
<flag name="ctrl_a" optional="true">
<description>Use Ctrl-A as the non-redundant defline separator</description>
<group>6</group>
</flag>
<flag name="exact_length" optional="true">
<description>Get exact length for db info</description>
<group>7</group>
</flag>
<flag name="get_dups" optional="true">
<description>Retrieve duplicate accessions</description>
<group>5</group>
</flag>
<flag name="h" optional="true">
<description>Print USAGE and DESCRIPTION;  ignore all other parameters</description>
</flag>
<flag name="help" optional="true">
<description>Print USAGE, DESCRIPTION and ARGUMENTS; ignore all other parameters</description>
</flag>
<flag name="info" optional="true">
<description>Print BLAST database information</description>
<group>2</group>
</flag>
<flag name="long_seqids" optional="true">
<description>Use long seq id for fasta deflines</description>
<group>7</group>
</flag>
<flag name="metadata" optional="true">
<description>Generate BLAST database metadata</description>
<group>2</group>
</flag>
<flag name="no_taxid_expansion" optional="true">
<description>Do not expand the taxonomy IDs provided to their descendant taxonomy IDs </description>
<group>4</group>
</flag>
<flag name="recursive" optional="true">
<description>Recursively traverse the directory structure to list available BLAST databases</description>
<group>7</group>
</flag>
<flag name="remove_redundant_dbs" optional="true">
<description>Remove the databases that are referenced by another alias file in the directory in question</description>
<group>7</group>
</flag>
<flag name="show_blastdb_search_path" optional="true">
<description>Displays the default BLAST database search paths</description>
<group>7</group>
</flag>
<flag name="target_only" optional="true">
<description>Definition line should contain target entry only</description>
<group>5</group>
</flag>
<flag name="tax_info" optional="true">
<description>Print taxonomic information contained in this BLAST database.&#xa;Use -outfmt to customize output. Format specifiers supported are:&#xa;&#x9;&#x9;%T means taxid&#xa;&#x9;&#x9;%L means common taxonomic name&#xa;&#x9;&#x9;%S means scientific name&#xa;&#x9;&#x9;%K means taxonomic super kingdom&#xa;&#x9;&#x9;%B means BLAST name&#xa;&#x9;&#x9;%n means num of seqs&#xa;By default it prints: &apos;%T %S %L %K %B&apos;&#xa;</description>
<group>2</group>
</flag>
<flag name="version" optional="true">
<description>Print version number;  ignore other arguments</description>
</flag>
