Blast-db-mask-info ::= {
  algo-id 2,
  algo-program dust,
  algo-options "e3 empty mask at 0 and tail",
  masks {
    masks {
      packed-int {
        {
          from 0,
          to 4294967295,
          id local id 3
        },
        {
          from 1100,
          to 1199,
          id local id 3
        }
      }
    },
    more FALSE
  }
}
