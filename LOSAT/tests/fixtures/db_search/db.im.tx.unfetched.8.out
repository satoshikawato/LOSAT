          },
          loc {
            int {
              from 30,
              to 227,
              strand plus,
              id local str "Query_1"
            },
            int {
              from 45,
              to 242,
              strand plus,
              id gi 777
            }
          },
          scores {
            {
              id str "score",
              value int 344
            },
            {
              id str "blast_score",
              value int 344
            },
            {
              id str "sum_n",
              value int 3
            },
            {
              id str "sum_e",
              value real { 193182356303818, 10, -89 }
            },
            {
              id str "bit_score",
              value real { 160523905109651, 10, -12 }
            },
            {
              id str "num_ident",
              value int 60
            },
            {
              id str "num_positives",
              value int 63
            },
            {
              id str "hsp_percent_coverage",
              value real { 1425, 10, -2 }
            }
          }
        }
      }
    }
  }
}
