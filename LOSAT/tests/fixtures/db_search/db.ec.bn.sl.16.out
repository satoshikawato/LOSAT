<?xml version="1.0" encoding="US-ASCII"?>
<BlastXML2
    xmlns="http://www.ncbi.nlm.nih.gov"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
    xs:schemaLocation="http://www.ncbi.nlm.nih.gov http://www.ncbi.nlm.nih.gov/data_specs/schema_alt/NCBI_BlastOutput2.xsd"
>
<BlastOutput2>
  <report>
    <Report>
      <program>blastn</program>
      <version>BLASTN 2.17.0+</version>
      <reference>Zheng Zhang, Scott Schwartz, Lukas Wagner, and Webb Miller (2000), &quot;A greedy algorithm for aligning DNA sequences&quot;, J Comput Biol 2000; 7(1-2):203-14.</reference>
      <search-target>
        <Target>
          <db>tests/db_search/taxfilter/tfn</db>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <expect>10</expect>
          <sc-match>1</sc-match>
          <sc-mismatch>-2</sc-mismatch>
          <gap-open>0</gap-open>
          <gap-extend>0</gap-extend>
          <filter>L;m;</filter>
        </Parameters>
      </params>
      <results>
        <Results>
          <search>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>first nucleotide query with a title long enough to be cut</query-title>
              <query-len>429</query-len>
              <hits></hits>
              <stat>
                <Statistics>
                  <db-num>16</db-num>
                  <db-len>10937</db-len>
                  <hsp-len>11</hsp-len>
                  <eff-space>236588</eff-space>
                  <kappa>0.46</kappa>
                  <lambda>1.28</lambda>
                  <entropy>0.85</entropy>
                </Statistics>
              </stat>
              <message>Query_1 first nucleotide .. :  Query_1 first nucleotide .. : Filtering resulted in an empty database.  No hits found</message>
            </Search>
          </search>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>

<BlastOutput2>
  <report>
    <Report>
      <program>blastn</program>
      <version>BLASTN 2.17.0+</version>
      <reference>Zheng Zhang, Scott Schwartz, Lukas Wagner, and Webb Miller (2000), &quot;A greedy algorithm for aligning DNA sequences&quot;, J Comput Biol 2000; 7(1-2):203-14.</reference>
      <search-target>
        <Target>
          <db>tests/db_search/taxfilter/tfn</db>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <expect>10</expect>
          <sc-match>1</sc-match>
          <sc-mismatch>-2</sc-mismatch>
          <gap-open>0</gap-open>
          <gap-extend>0</gap-extend>
          <filter>L;m;</filter>
        </Parameters>
      </params>
      <results>
        <Results>
          <search>
            <Search>
              <query-id>Query_2</query-id>
              <query-title>second</query-title>
              <query-len>444</query-len>
              <hits></hits>
              <stat>
                <Statistics>
                  <db-num>16</db-num>
                  <db-len>10937</db-len>
                  <hsp-len>11</hsp-len>
                  <eff-space>245078</eff-space>
                  <kappa>0.46</kappa>
                  <lambda>1.28</lambda>
                  <entropy>0.85</entropy>
                </Statistics>
              </stat>
              <message>Query_2 second:  Query_2 second: Filtering resulted in an empty database.  No hits found</message>
            </Search>
          </search>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>
</BlastXML2>
