+// NCBI reference: c++/src/algo/blast/core/blast_engine.c:1659-1668
+// /* Use a local diagnostics structure ... shared between multiple threads */
+// Isolated diagnostic: nested aggregate durations are not additive wall time.
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+static NS: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+static CALLS: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+static RECORDS: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+static BYTES: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+pub struct Scope { id: usize, records: u64, bytes: u64, start: Instant }
+impl Scope {
+    pub fn new(id: usize, records: usize, width: usize) -> Self {
+        Self { id, records: records as u64, bytes: records as u64 * width as u64, start: Instant::now() }
+    }
+}
+impl Drop for Scope {
+    fn drop(&mut self) {
+        NS[self.id].fetch_add(self.start.elapsed().as_nanos() as u64, Relaxed);
+        CALLS[self.id].fetch_add(1, Relaxed);
+        RECORDS[self.id].fetch_add(self.records, Relaxed);
+        BYTES[self.id].fetch_add(self.bytes, Relaxed);
+    }
+}
+pub struct Report;
+impl Drop for Report {
+    fn drop(&mut self) {
+        for (i, name) in ["x_sort_original_clone", "x_sort_indices", "x_sort_writeback_clone", "x_link_total", "x_chain_replay_clone", "x_sort_total", "x_link_sort_total"].iter().enumerate() {
+            eprintln!("[X_COST] name={} calls={} aggregate_ns={} records={} logical_clone_bytes={}", name, CALLS[i].load(Relaxed), NS[i].load(Relaxed), RECORDS[i].load(Relaxed), BYTES[i].load(Relaxed));
+        }
+        eprintln!("[X_COST] hsp_width={}", std::mem::size_of::<crate::algorithm::tblastx::chaining::UngappedHit>());
+    }
+}
