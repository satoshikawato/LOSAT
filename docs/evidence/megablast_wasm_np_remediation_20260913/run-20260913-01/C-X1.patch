+            .map(|index| {
+                let position = (index % 12) * 30;
+                let mut hit = mock_hit(
+                    position,
+                    position + 20,
+                    position,
+                    position + 20,
+                    40 + (index % 4) as i32,
+                );
+                hit.ctx_idx = index / 8;
+                hit.q_idx = (hit.ctx_idx / 6) as u32;
+                hit.q_frame = contexts[hit.ctx_idx].frame;
+                hit.s_frame = if index / 4 % 2 == 0 { -1 } else { 1 };
+                hit.q_orig_len = 6000;
+                hit.s_orig_len = 6000;
+                hit.hsp_list_order = index;
+                hit
