      annot { { data ftable {
        { data gene { locus "SplitGene" }, location mix { int { from 5, to 15, id local str "sp4a" }, int { from 35, to 55, id local str "sp4a" } } },
        { data cdregion {}, location mix { int { from 10, to 20, id local str "sp4a" }, int { from 40, to 50, id local str "sp4a" } }, xref { { data prot { name { "kinase A" } } } } }
