+            .get(lhs)
+            .and_then(|&handle| hsp_for_handle(hsp_storage, handle)),
+        hsp_array
+            .get(rhs)
+            .and_then(|&handle| hsp_for_handle(hsp_storage, handle)),
+    ) else {
