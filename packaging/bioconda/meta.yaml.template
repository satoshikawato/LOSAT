{% set name = "losat" %}
{% set version = "0.2.0" %}

package:
  name: {{ name }}
  version: {{ version }}

source:
  url: https://github.com/satoshikawato/LOSAT/archive/refs/tags/v{{ version }}.tar.gz
  sha256: __REPLACE_WITH_V0_2_0_TAG_TARBALL_SHA256__

build:
  number: 0

requirements:
  build:
    - {{ compiler('rust') }}
    - cargo-bundle-licenses

test:
  commands:
    - losat --version
    - losat --help
    - losat blastn -help
    - losat blastp -help
    - losat blastx -help
    - losat tblastn -help
    - losat tblastx -help
    - losat psiblast -help
    - losat deltablast -help
    - losat rpsblast -help
    - losat rpstblastn -help
    - blastn -version
    - blastp -version
    - blastx -version
    - tblastn -version
    - tblastx -version
    - psiblast -version
    - deltablast -version
    - rpsblast -version
    - rpstblastn -version
    - makeblastdb -version
    - blastdbcmd -version
    - dustmasker -version
    - segmasker -version
    - windowmasker -version
    - convert2blastmask -version
    - makembindex -version
    - makeprofiledb -version
    - rpsbproc -version
    - blastdb_aliastool -version
    - blastdbcheck -version
    - cleanup-blastdb-volumes.py -version
    - blast_formatter -version

about:
  home: https://github.com/satoshikawato/LOSAT
  license: MIT
  license_family: MIT
  license_file:
    - LICENSE
    - THIRD_PARTY_NOTICES
    - THIRDPARTY.yml
  summary: Pure-Rust NCBI BLAST+ search programs with byte-identical output
  description: |
    LOSAT is a standalone, pure-Rust implementation of NCBI BLAST+ 2.17.0 local
    sequence search. It runs NCBI's command lines for blastn, blastp, blastx,
    tblastn, tblastx, psiblast and deltablast against FASTA subjects (-subject) or BLAST
    databases (-db), rpsblast and rpstblastn against profile databases (-db),
    and provides makeblastdb, blastdbcmd,
    dustmasker, segmasker, windowmasker, convert2blastmask, makembindex,
    makeprofiledb, rpsbproc, blastdb_aliastool, blastdbcheck, cleanup-blastdb-volumes.py and blast_formatter. Its output equals NCBI BLAST+ 2.17.0's on the release test set (E-values, bit
    scores, coordinates and every output format byte for byte), and it needs no
    BLAST+ installation.
  dev_url: https://github.com/satoshikawato/LOSAT
  doc_url: https://satoshikawato.github.io/LOSAT/

extra:
  additional-platforms:
    - linux-aarch64
    - osx-arm64
  recipe-maintainers:
    - satoshikawato
