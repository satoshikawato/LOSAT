Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastx",
      service "plain",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">c01241_q"
                  }
                }
              },
              title "c01241_q"
            },
            inst {
              repr raw,
              mol na,
              length 15,
              seq-data ncbi2na 'F7579530'H
            }
          }
        }
      },
      subject database "../db_search/x2g_s1",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 5 }
        },
        {
          name "WordSize",
          value integer 3
        },
        {
          name "LongestIntronLength",
          value integer 0
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "WordThreshold",
          value integer 3
        },
        {
          name "WindowSize",
          value integer 0
        },
        {
          name "UngappedMode",
          value boolean TRUE
        },
        {
          name "QueryGeneticCode",
          value integer 1
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "CompositionBasedStats",
          value integer 0
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 25
        }
      }
    }
  },
  results {
    alignments {
      {
        type diags,
        segs std {
          {
            dim 2,
            ids {
              local str "Query_1",
              general {
                db "BL_ORD_ID",
                tag id 0
              }
            },
            loc {
              int {
                from 3,
                to 2,
                strand plus,
                id local str "Query_1"
              },
              int {
                from 1,
                to 0,
                strand unknown,
                id general {
                  db "BL_ORD_ID",
                  tag id 0
                }
              }
            },
            scores {
              {
                id str "score",
                value int 5
              },
              {
                id str "blast_score",
                value int 5
              },
              {
                id str "e_value",
                value real { 136854811075767, 10, -14 }
              },
              {
                id str "bit_score",
                value real { 519121003681722, 10, -14 }
              },
              {
                id str "num_ident",
                value int 0
              },
              {
                id str "hsp_percent_coverage",
                value real { 5, 10, -1 }
              }
            }
          }
        }
      }
    },
    masks {
    },
    ka-blocks {
      {
        lambda { 317605957635731, 10, -15 },
        k { 133956144488482, 10, -15 },
        h { 401214524497119, 10, -15 },
        gapped FALSE
      },
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 25",
      "Effective search space used: 25",
      "Length adjustment: 0"
    }
  }
}
