Blast-db-mask-info ::= { algo-id 0, algo-program windowmasker, algo-options "x", masks { masks { packed-int { { from 5, to 14,  id local id 3 } } }, more FALSE } }
Blast-db-mask-info ::= { algo-id 1, algo-program dust, algo-options "y", masks { masks { packed-int { { from 20, to 29,  id local id 4 } } }, more FALSE } }
