Bioseq-set ::= {
  seq-set {
    seq {
      id { other { accession "NM_000500", version 1 }, gi 900500 },
      descr { molinfo { biomol mRNA }, source { org { taxname "Homo sapiens" } } },
      inst { repr raw, mol rna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
      annot { { data ftable {
        { data gene { locus-tag "LTORF" }, location int { from 0, to 29, id other { accession "NM_000500", version 1 } } },
        { data cdregion { orf TRUE }, location mix { int { from 0, to 29, strand minus, id other { accession "NM_000500", version 1 } }, empty gi 900500 } }
      } } }
