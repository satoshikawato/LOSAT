Bioseq-set ::= {
      seq-set {
        seq { id { local str "Query_1" }, descr { title "d1" }, inst { repr raw, mol na, length 4, seq-data iupacna "ACGT" } },
        seq { id { local str "Query_1" }, descr { title "d2" }, inst { repr raw, mol na, length 4, seq-data iupacna "ACGT" } }
      }
    }
