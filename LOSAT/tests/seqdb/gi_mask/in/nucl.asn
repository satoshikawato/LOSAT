Bioseq-set ::= {
  seq-set {
    seq {
      id { gi 1001, genbank { accession "AB000001", version 1 } },
      descr { title "one" },
      inst { repr raw, mol dna, length 460, seq-data iupacna "" }
    },
    seq {
      id { gi 1002, genbank { accession "AB000002", version 1 } },
      descr { title "two" },
      inst { repr raw, mol dna, length 520, seq-data iupacna "" }
    },
    seq {
      id { gi 2000000000, genbank { accession "AB000003", version 1 } },
      descr { title "three" },
      inst { repr raw, mol dna, length 400, seq-data iupacna "" }
    },
    seq {
      id { gi 3000000000, genbank { accession "AB000004", version 1 } },
      descr { title "four above INT4_MAX" },
      inst { repr raw, mol dna, length 405, seq-data iupacna "" }
    },
    seq {
      id { genbank { accession "AB000005", version 1 } },
      descr { title "five no gi" },
      inst { repr raw, mol dna, length 400, seq-data iupacna "" }
    },
    seq {
      id { gi 1006, embl { accession "CAA00006", version 1 } },
      descr { title "six" },
      inst { repr raw, mol dna, length 410, seq-data iupacna "" }
    },
    seq {
      id { gi 1007, genbank { accession "AB000007", version 1 } },
      descr { title "seven no low complexity" },
      inst { repr raw, mol dna, length 400, seq-data iupacna "" }
    },
    seq {
      id { gi 999, genbank { accession "AB000008", version 1 } },
      descr { title "eight" },
      inst { repr raw, mol dna, length 400, seq-data iupacna "" }
    },
    seq {
      id { local str "seq9" },
      descr { title "nine local id" },
      inst { repr raw, mol dna, length 400, seq-data iupacna "" }
    },
    seq {
      id { gi 5, genbank { accession "AB000010", version 1 } },
      descr { title "ten small gi" },
      inst { repr raw, mol dna, length 400, seq-data iupacna "" }
    },
    seq {
      id { gi 1011, other { accession "NM_000011", version 1 } },
      descr { title "eleven" },
      inst { repr raw, mol dna, length 425, seq-data iupacna "" }
    },
    seq {
      id { gi 1012 },
