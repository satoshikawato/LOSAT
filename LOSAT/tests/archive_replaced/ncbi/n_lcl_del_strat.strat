Blast4-request ::= {
  body queue-search {
    program "blastn",
    service "megablast",
    queries bioseq-set {
      seq-set {
        seq {
          id {
            local str "a#b"
          },
          descr {
            user {
              type str "CFastaReader",
              data {
                {
                  label str "DefLine",
                  data str ">lcl|a\177b d\303\251"
                }
              }
            },
            title "d##"
          },
          inst {
            repr raw,
            mol na,
            length 180,
            seq-data ncbi2na '3A33EFEB717FDE76CF4BF9D2CEF59600F3DBFC5E930D35B7
7A0AFA0EB6D2FF38CFAE00C5ACEFDB7ABFD603F3EB'H
          }
        }
      }
    },
    subject sequences {
      {
        id {
          local str "s1"
        },
        descr {
          user {
            type str "CFastaReader",
            data {
              {
                label str "DefLine",
                data str ">s1 subject"
              }
            }
          },
          title "subject"
        },
        inst {
          repr raw,
          mol na,
          length 180,
          seq-data ncbi2na '3A33EFEB717FDE76CF4BF9D2CEF59600F3DBFC5E930D35B77A
0AFA0EB6D2FF38CFAE00C5ACEFDB7ABFD603F3EB'H
        }
      },
      {
        id {
          local str "s2"
        },
        descr {
          user {
            type str "CFastaReader",
            data {
              {
                label str "DefLine",
                data str ">s2 other"
              }
            }
          },
          title "other"
        },
        inst {
          repr raw,
          mol na,
          length 150,
          seq-data ncbi2na '1FEDA9F6CDE9F4E7DA90DF0756B028E460FB8DA88A5764C262
B12BABE6FDFC57C0DC984C62A0'H
        }
      }
    },
    algorithm-options {
      {
        name "EvalueThreshold",
        value cutoff e-value { 1, 10, 1 }
      },
      {
        name "MaskAtHash",
        value boolean TRUE
      },
      {
        name "UngappedMode",
        value boolean FALSE
      },
      {
        name "HitlistSize",
        value integer 500
      }
    }
  }
}
