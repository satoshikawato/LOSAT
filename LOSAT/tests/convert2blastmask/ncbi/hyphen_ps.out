Blast-db-mask-info ::= {
  algo-id 0,
  algo-program dust,
  algo-options "o",
  masks {
    masks {
      packed-int {
        {
          from 0,
          to 3,
          id local str "h"
        },
        {
          from 5,
          to 8,
          id local str "h"
        },
        {
          from 16,
          to 19,
          id local str "h"
        }
      }
    },
    more FALSE
  }
}
