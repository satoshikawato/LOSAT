          tag id 4
        }
      },
      int {
        from 0,
        to 63,
        id general {
          db "BL_ORD_ID",
          tag id 5
        }
      },
      int {
        from 0,
        to 64,
        id general {
          db "BL_ORD_ID",
          tag id 6
        }
      }
    },
    more FALSE
  }
}
