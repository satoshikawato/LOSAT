          inst { repr raw, mol aa, length 10, seq-data ncbieaa "MKKKKKKKKK" },
          annot { { data ftable {
            { data prot { name { "probe protein 106" } }, location whole genbank { accession "BAB01206", version 1 } }
          } } }
        }
      }
    },
    set {
      class nuc-prot,
      descr { comment "local id product on str" },
      seq-set {
        seq {
          id { genbank { accession "AB000107", version 1 } },
          descr { title "nuc 107", molinfo { biomol genomic } },
          inst { repr raw, mol dna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
          annot { { data ftable {
            { data cdregion { frame one }, product whole local id 1207, location int { from 2, to 20, id genbank { accession "AB000107", version 1 } } },
            { data biosrc { org { taxname "Escherichia coli" } }, location int { from 0, to 29, id genbank { accession "AB000107", version 1 } } }
          } } }
        },
        seq {
          id { local str "1207" },
          descr { molinfo { biomol peptide } },
          inst { repr raw, mol aa, length 10, seq-data ncbieaa "MKKKKKKKKK" },
          annot { { data ftable {
            { data prot { name { "probe protein 107" } }, location whole local str "1207" }
          } } }
        }
      }
    },
    set {
      class nuc-prot,
      descr { comment "general id product on str" },
      seq-set {
        seq {
          id { genbank { accession "AB000108", version 1 } },
          descr { title "nuc 108", molinfo { biomol genomic } },
          inst { repr raw, mol dna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
          annot { { data ftable {
            { data cdregion { frame one }, product whole general { db "DB", tag id 1208 }, location int { from 2, to 20, id genbank { accession "AB000108", version 1 } } },
            { data biosrc { org { taxname "Escherichia coli" } }, location int { from 0, to 29, id genbank { accession "AB000108", version 1 } } }
          } } }
        },
        seq {
          id { general { db "DB", tag str "1208" } },
          descr { molinfo { biomol peptide } },
          inst { repr raw, mol aa, length 10, seq-data ncbieaa "MKKKKKKKKK" },
          annot { { data ftable {
            { data prot { name { "probe protein 108" } }, location whole general { db "DB", tag str "1208" } }
          } } }
        }
      }
    },
    set {
      class nuc-prot,
      descr { comment "gb product on ref" },
      seq-set {
        seq {
          id { genbank { accession "AB000109", version 1 } },
          descr { title "nuc 109", molinfo { biomol genomic } },
          inst { repr raw, mol dna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
          annot { { data ftable {
            { data cdregion { frame one }, product whole genbank { accession "BAB01209", version 1 }, location int { from 2, to 20, id genbank { accession "AB000109", version 1 } } },
            { data biosrc { org { taxname "Escherichia coli" } }, location int { from 0, to 29, id genbank { accession "AB000109", version 1 } } }
          } } }
        },
        seq {
          id { other { accession "BAB01209", version 1 } },
          descr { molinfo { biomol peptide } },
          inst { repr raw, mol aa, length 10, seq-data ncbieaa "MKKKKKKKKK" },
          annot { { data ftable {
            { data prot { name { "probe protein 109" } }, location whole other { accession "BAB01209", version 1 } }
          } } }
        }
      }
