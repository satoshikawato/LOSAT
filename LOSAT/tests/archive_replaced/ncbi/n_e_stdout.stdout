Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastn",
      service "megablast",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">q1 caf\303\251 title"
                  }
                }
              },
              title "q1 caf## title"
            },
            inst {
              repr raw,
              mol na,
              length 180,
              seq-data ncbi2na '3A33EFEB717FDE76CF4BF9D2CEF59600F3DBFC5E930D35
B77A0AFA0EB6D2FF38CFAE00C5ACEFDB7ABFD603F3EB'H
            }
          }
        }
      },
      subject sequences {
        {
          id {
            local str "Subject_1"
          },
          descr {
            user {
              type str "CFastaReader",
              data {
                {
                  label str "DefLine",
                  data str ">s1 subject"
                }
              }
            },
            title "s1 subject"
          },
          inst {
            repr raw,
