                    <Hsp>
                      <num>1</num>
                      <bit-score>127.872</bit-score>
                      <score>320</score>
                      <evalue>1.79607e-46</evalue>
                      <identity>60</identity>
                      <positive>60</positive>
                      <query-from>1</query-from>
                      <query-to>180</query-to>
                      <query-frame>1</query-frame>
                      <hit-from>1</hit-from>
                      <hit-to>60</hit-to>
                      <align-len>60</align-len>
                      <gaps>0</gaps>
                      <qseq>MDIVWSTFSARIQFAQYVPPKIIRFTWHNHPSLEGWNGRQFYDIGENTGMFRLGFPKFIG</qseq>
                      <hseq>MDIVWSTFSARIQFAQYVPPKIIRFTWHNHPSLEGWNGRQFYDIGENTGMFRLGFPKFIG</hseq>
                      <midline>MDIVWSTFSARIQFAQYVPPKIIRFTWHNHPSLEGWNGRQFYDIGENTGMFRLGFPKFIG</midline>
                    </Hsp>
                  </hsps>
                </Hit>
              </hits>
              <stat>
                <Statistics>
                  <hsp-len>4</hsp-len>
                  <eff-space>3136</eff-space>
                  <kappa>0.041</kappa>
                  <lambda>0.267</lambda>
                  <entropy>0.14</entropy>
                </Statistics>
              </stat>
            </Search>
