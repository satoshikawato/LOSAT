<?xml version="1.0" encoding="US-ASCII"?>
<BlastXML2
    xmlns="http://www.ncbi.nlm.nih.gov"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
    xs:schemaLocation="http://www.ncbi.nlm.nih.gov http://www.ncbi.nlm.nih.gov/data_specs/schema_alt/NCBI_BlastOutput2.xsd"
>
<BlastOutput2>
  <report>
    <Report>
      <program>tblastn</program>
      <version>TBLASTN 2.17.0+</version>
      <reference>Stephen F. Altschul, Thomas L. Madden, Alejandro A. Sch&amp;auml;ffer, Jinghui Zhang, Zheng Zhang, Webb Miller, and David J. Lipman (1997), &quot;Gapped BLAST and PSI-BLAST: a new generation of protein database search programs&quot;, Nucleic Acids Res. 25:3389-3402.</reference>
      <search-target>
        <Target>
          <db>tests/db_search/nz_rep</db>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <matrix>BLOSUM62</matrix>
          <expect>0.001</expect>
          <gap-open>11</gap-open>
          <gap-extend>1</gap-extend>
          <filter>F</filter>
          <db-gencode>1</db-gencode>
        </Parameters>
      </params>
      <results>
        <Results>
          <search>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>qD</query-title>
              <query-len>40</query-len>
              <hits>
                <Hit>
                  <num>1</num>
                  <description>
                    <HitDescr>
                      <id>d1</id>
                      <accession>d1</accession>
                      <title>nz rep d1</title>
                    </HitDescr>
                  </description>
                  <len>180</len>
                  <hsps>
                    <Hsp>
                      <num>1</num>
                      <bit-score>91.2781</bit-score>
                      <score>225</score>
                      <evalue>4.94966e-32</evalue>
                      <identity>40</identity>
                      <positive>40</positive>
                      <query-from>1</query-from>
                      <query-to>40</query-to>
                      <hit-from>1</hit-from>
                      <hit-to>120</hit-to>
                      <hit-frame>1</hit-frame>
                      <align-len>40</align-len>
                      <gaps>0</gaps>
                      <qseq>MCDFIAYMPKAAEHKFGLWFMAITADWTSTIHDNQVQDGQ</qseq>
                      <hseq>MCDFIAYMPKAAEHKFGLWFMAITADWTSTIHDNQVQDGQ</hseq>
                      <midline>MCDFIAYMPKAAEHKFGLWFMAITADWTSTIHDNQVQDGQ</midline>
                    </Hsp>
                  </hsps>
                </Hit>
              </hits>
              <stat>
                <Statistics>
                  <db-num>4</db-num>
                  <db-len>735</db-len>
                  <hsp-len>9</hsp-len>
                  <eff-space>6479</eff-space>
                  <kappa>0.041</kappa>
                  <lambda>0.267</lambda>
                  <entropy>0.14</entropy>
                </Statistics>
              </stat>
            </Search>
          </search>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>
</BlastXML2>
