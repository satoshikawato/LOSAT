Blast-db-mask-info ::= {
  algo-id 2,
  algo-program seg,
  algo-options "overlap thm20f",
  masks {
    masks {
      packed-int {
        {
          from 10,
          to 299,
          id local id 1
        },
        {
          from 20,
          to 309,
          id local id 1
        }
      }
    },
    more FALSE
  }
}
