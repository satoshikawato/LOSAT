Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "plain",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">pm1 masked protein"
                  }
                }
              },
              title "pm1 masked protein"
            },
            inst {
              repr raw,
              mol aa,
              length 60,
              seq-data ncbieaa "DYLTKKIELDDHAAHLLFSAQQQQQQQQQQQQQQQQQQQQNRWEVC
SKIKQLLDDGIHVV"
            }
          }
        }
      },
      subject sequences {
        {
          id {
            local str "Subject_1"
          },
          descr {
            user {
              type str "CFastaReader",
              data {
                {
                  label str "DefLine",
                  data str ">spm1 masked protein subject"
                }
              }
            },
            title "spm1 masked protein subject"
          },
          inst {
            repr raw,
            mol aa,
            length 66,
            seq-data ncbieaa "MKTDYLTKKIELDDHAAHLLFSAQQQQQQQQQQQQQQQQQQQQNRWEV
CSKIKQLLDDGIHVVGSW"
          }
        }
      },
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean TRUE
        },
        {
          name "WordThreshold",
          value integer 11
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "UngappedMode",
          value boolean FALSE
        },
        {
          name "CompositionBasedStats",
          value integer 2
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 3355
        }
      }
    }
  },
  results {
    alignments {
      {
        type partial,
        dim 2,
        score {
          {
            id str "score",
            value int 183
          },
          {
            id str "blast_score",
            value int 183
          },
          {
            id str "e_value",
            value real { 196771188267428, 10, -39 }
          },
          {
            id str "bit_score",
            value real { 750997546729196, 10, -13 }
          },
          {
            id str "num_ident",
            value int 60
          },
          {
            id str "comp_adjustment_method",
            value int 2
          },
          {
            id str "num_positives",
            value int 60
          },
          {
            id str "hsp_percent_coverage",
            value real { 1, 10, 2 }
          }
        },
        segs denseg {
          dim 2,
          numseg 1,
          ids {
            local str "Query_1",
            local str "Subject_1"
          },
          starts {
            0,
            3
          },
          lens {
            60
          },
          strands {
            plus,
            plus
          }
        }
      }
    },
    masks {
      {
        locations {
          packed-int {
            {
              from 20,
              to 39,
              id local str "Query_1"
            }
          }
        },
        frame notset
      }
    },
    ka-blocks {
      {
        lambda { 323023089996218, 10, -15 },
        k { 138409661875776, 10, -15 },
        h { 427524054562414, 10, -15 },
        gapped FALSE
      },
      {
        lambda { 267, 10, -3 },
        k { 41, 10, -3 },
        h { 14, 10, -2 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 3355",
      "Effective search space used: 3355",
      "Length adjustment: 5"
    }
  }
}
