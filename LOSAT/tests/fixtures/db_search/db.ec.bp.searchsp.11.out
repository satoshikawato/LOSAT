Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "plain",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">first protein query with a title long enough to
 be cut"
                  }
                }
              },
              title "first protein query with a title long enough to be cut"
            },
            inst {
              repr raw,
              mol aa,
              length 142,
              seq-data ncbieaa "MVLSPADKTNVKAAWGKVGAHAGEYGAEALERMFLSFPTTKTYFPH
FDLSHGSAQVKGHGKKVADALTNAVAHVDDMPNALSALSDLHAHKLRVDPVNFKLLSHCLLVTLAAHLPAEFTPAVHA
SLDKFLASVSTVLTSKYR"
            }
          },
          seq {
            id {
              local str "Query_2"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">second"
                  }
                }
              },
              title "second"
            },
            inst {
              repr raw,
              mol aa,
              length 147,
              seq-data ncbieaa "MVHLTPEEKSAVTALWGKVNVDEVGGEALGRLLVVYPWTQRFFESF
GDLSTPDAVMGNPKVKAHGKKVLGAFSDGLAHLDNLKGTFATLSELHCDKLHVDPENFRLLGNVLVCVLAHHFGKEFT
PPVQAAYQKVVAGVANALAHKYH"
            }
          }
        }
      },
      subject database "tests/db_search/taxfilter/tfp",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 1000000
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "WordThreshold",
          value integer 11
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "UngappedMode",
          value boolean FALSE
        },
        {
          name "CompositionBasedStats",
          value integer 2
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        }
      },
      program-options {
        {
          name "TaxidList",
          value integer-list {
          }
        }
      }
    }
  },
  results {
    alignments {
    },
    masks {
    },
    ka-blocks {
      {
        lambda { 318984985166634, 10, -15 },
        k { 130238418667706, 10, -15 },
        h { 384901552979004, 10, -15 },
        gapped FALSE
      },
      {
        lambda { 267, 10, -3 },
        k { 41, 10, -3 },
        h { 14, 10, -2 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 1000000",
      "Effective search space used: 1000000",
      "Length adjustment: 16"
    }
  },
  messages {
    {
      code 1,
      message "Warning: [blastp] To obtain better run time performance, please
 run blastdb_aliastool -seqid_file_in <INPUT_FILE_NAME> -seqid_file_out
 <OUT_FILE_NAME> and use <OUT_FILE_NAME> as the argument to -seqidlist"
    }
  }
}
