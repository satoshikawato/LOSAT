Blast-db-mask-info ::= {
  algo-id 0,
  algo-program dust,
  algo-options "o",
  masks {
    masks {
      packed-int {
        {
          from 2,
          to 8,
          id local str "g"
        },
        {
          from 11,
          to 12,
          id local str "g"
        }
      }
    },
    more FALSE
  }
}
