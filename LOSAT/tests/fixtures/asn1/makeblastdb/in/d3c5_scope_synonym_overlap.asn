Bioseq-set ::= {
  class genbank,
  seq-set {
    set {
      class nuc-prot,
      seq-set {
        seq {
          id { genbank { accession "AB000971", version 1 } },
          descr { title "nuc 971", molinfo { biomol genomic } },
          inst { repr raw, mol dna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
          annot { { data ftable {
            { data cdregion { frame one }, product whole genbank { accession "BAA00971", version 1 }, location int { from 0, to 29, id genbank { accession "AB000971", version 1 } } },
            { data biosrc { org { taxname "Escherichia coli" } }, location int { from 0, to 29, id genbank { accession "AB000971", version 1 } } }
          } } }
        },
        seq {
          id { genbank { accession "BAA00971", version 1 } },
          descr { molinfo { biomol peptide } },
          inst { repr raw, mol aa, length 10, seq-data ncbieaa "MKKKKKKKKK" },
          annot { { data ftable {
            { data prot { name { "probe protein 971" } }, location whole genbank { accession "BAA00971", version 1 } }
          } } }
        }
      }
    },
    set {
