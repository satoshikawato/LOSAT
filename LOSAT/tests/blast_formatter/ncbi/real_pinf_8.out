Seq-annot ::= {
  desc {
    user {
      type str "Hist Seqalign",
      data {
        {
          label str "Hist Seqalign",
          data bool TRUE
        }
      }
    },
    user {
      type str "Blast Type",
      data {
        {
          label str "blastn",
          data int 1
        }
      }
    },
    user {
      type str "Blast Database Title",
      data {
        {
          label str "n/a",
          data bool FALSE
        }
      }
    }
  },
  data align {
    {
      type partial,
      dim 2,
      score {
        {
          id str "score",
          value int 117
        },
        {
          id str "blast_score",
          value int 117
        },
        {
          id str "e_value",
          value real PLUS-INFINITY
        },
        {
          id str "bit_score",
          value real { 217178303557249, 10, -12 }
        },
        {
          id str "num_ident",
          value int 119
        },
        {
          id str "hsp_percent_coverage",
          value real { 1, 10, 2 }
        }
      },
      segs denseg {
        dim 2,
        numseg 1,
        ids {
          local str "Query_1",
          local str "Subject_1"
        },
        starts {
          0,
          100
        },
        lens {
          120
        },
        strands {
          plus,
          plus
        }
      }
    }
  }
}
