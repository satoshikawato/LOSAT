Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastn",
      service "megablast",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">q1 first query caf\303\251"
                  }
                }
              },
              title "q1 first query caf##"
            },
            inst {
              repr raw,
              mol na,
              length 180,
              seq-data ncbi2na '39EED933F0A147E4D28BA66454330F79AE5186D755D1A6
FB94187684EE84C613BD0798627530AA842993825112'H
            }
          },
          seq {
            id {
              local str "Query_2"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">q2 second query"
                  }
                }
              },
              title "q2 second query"
            },
            inst {
              repr raw,
              mol na,
              length 180,
              seq-data ncbi2na '3A48C78D08BB43DA4E42375C062E83ECC45A740FE43ED8
0091A0873733A2BBE7F1EDFEC78F9060988850D510FD'H
            }
          }
        }
      },
      subject database "tests/db_search/arch_snucl",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "MaskAtHash",
          value boolean TRUE
        },
        {
          name "UngappedMode",
          value boolean FALSE
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 159367
        }
      }
    }
  },
  results {
    alignments {
    },
    masks {
    },
    ka-blocks {
      {
        lambda { 133270576282382, 10, -14 },
        k { 620991117264207, 10, -15 },
        h { 112409184650115, 10, -14 },
        gapped FALSE
      },
      {
        lambda { 128, 10, -2 },
        k { 46, 10, -2 },
        h { 85, 10, -2 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 159367",
      "Effective search space used: 159367",
      "Length adjustment: 11"
    }
  }
}
