Seq-entry ::= set {
  seq-set {
    seq {
      id { local str "s1" },
      descr { title "t" },
      inst { repr raw, mol dna, length 120, seq-data iupacna "ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT" }
      ,annot { { data ftable {
        { data imp { key "misc_feature" }, location mix { int { from 0, to 5, strand minus, id local str "s1" }, int { from 10, to 9, strand minus, id local str "s1" } } }
      } } }
    },
    seq {
      id { local str "s2" },
      descr { title "t2", user { type str "ASN1_BlastDefLine", data { { label str "ASN1_BlastDefLine", data oss { '30803080A0801A01740000A180308005000000000000000000'H } } } } },
      inst { repr raw, mol dna, length 4, seq-data iupacna "ACGT" }
    }
  }
}
