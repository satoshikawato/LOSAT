+    seq2_index = *seq2_align_len;
+    // NCBI reference: ncbi-blast/c++/src/algo/blast/core/greedy_align.c:697-751
+    // ```c
+    // d = best_dist;
+    // seq2_index = *seq2_align_len;
+    //
+    // if (fence_hit && *fence_hit)
+    //     goto done;
+    // ...
+    // done:
+    // GapPrelimEditBlockAdd(edit_block, eGapAlignSub,
+    //                       last_seq2_off[0][diag_origin]);
