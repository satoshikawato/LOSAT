Blast-db-mask-info ::= {
  algo-id 0,
  algo-program dust,
  algo-options "o",
  masks {
    masks {
      packed-int {
        {
          from 0,
          to 3,
          id local str "c"
        },
        {
          from 8,
          to 11,
          id local str "c"
        }
      }
    },
    more FALSE
  }
}
