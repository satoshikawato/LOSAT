          <subjects>Subject_4</subjects>
          <subjects>Subject_5</subjects>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <matrix>BLOSUM62</matrix>
          <expect>10</expect>
          <gap-open>11</gap-open>
          <gap-extend>1</gap-extend>
          <filter>L;</filter>
          <cbs>2</cbs>
          <db-gencode>1</db-gencode>
        </Parameters>
      </params>
      <results>
        <Results>
          <bl2seq>
            <Search>
              <query-id>Query_2</query-id>
              <query-title>q2 withO</query-title>
              <query-len>60</query-len>
              <query-masking>
                <Range>
                  <from>31</from>
                  <to>53</to>
                </Range>
              </query-masking>
              <hits></hits>
              <stat>
                <Statistics>
                  <hsp-len>35</hsp-len>
                  <eff-space>253950</eff-space>
                  <kappa>0.041</kappa>
                  <lambda>0.267</lambda>
                  <entropy>0.14</entropy>
                </Statistics>
              </stat>
              <message>Query_2 q2 withO:  Query_2 q2 withO: One or more O characters replaced by X for alignment score calculations at positions 58  No hits found</message>
            </Search>
          </bl2seq>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>

