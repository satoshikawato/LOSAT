Seq-entry ::= seq {
  id { local str "s1" },
  descr {
    source { org { taxname "Homo sapiens" } },
    user { type str "AutodefOptions", data {  } }
  },
  inst { repr raw, mol dna, length 120, seq-data iupacna "ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT" },
  annot { { data ftable {
    { data gene { locus "abc" }, location mix { empty local str "X", int { from 0, to 29, id local str "s1" } } }
  } } }
}
