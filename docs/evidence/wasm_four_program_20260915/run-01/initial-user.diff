+/// Build lookup tables based on configuration
+pub fn build_lookup_tables(
+    config: &TaskConfig,
+    args: &BlastnArgs,
+    queries_blastna: &[Vec<u8>],
+    query_masks: &[Vec<MaskedInterval>],
