+    #[test]
+    fn test_traceback_fence_exposes_only_initialized_prefix() {
+        for (reverse, capacity, gap_extend) in
+            [(false, 48, 1), (true, 48, 1), (false, 8, 0), (true, 8, 0)]
+        {
+            for fence_b_index in [0usize, 1, 7] {
+                let query = [ncbistdaa::A; 9];
