Blast-db-mask-info ::= {
  algo-id 2,
  algo-program seg,
  algo-options "overlap r37",
  masks {
    masks {
      packed-int {
        {
          from 40,
          to 79,
          id local id 1
        },
        {
          from 43,
          to 89,
          id local id 1
        }
      }
    },
    more FALSE
  }
}
