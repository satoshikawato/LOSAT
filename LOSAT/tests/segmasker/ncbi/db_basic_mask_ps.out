Blast-db-mask-info ::= {
  algo-id 1,
  algo-program seg,
  algo-options "window=12; locut=2.2; hicut=2.5",
  masks {
    masks {
      packed-int {
        {
          from 2,
          to 14,
          id general {
            db "BL_ORD_ID",
            tag id 0
          }
        },
        {
          from 15,
          to 50,
          id general {
            db "BL_ORD_ID",
            tag id 0
          }
        }
      },
      packed-int {
        {
          from 25,
          to 39,
          id general {
            db "BL_ORD_ID",
            tag id 2
          }
        },
        {
          from 43,
          to 58,
          id general {
            db "BL_ORD_ID",
            tag id 2
          }
        },
        {
          from 149,
          to 169,
          id general {
            db "BL_ORD_ID",
            tag id 2
          }
        },
        {
          from 200,
          to 255,
          id general {
            db "BL_ORD_ID",
            tag id 2
          }
        }
      }
    },
    more FALSE
  }
}
