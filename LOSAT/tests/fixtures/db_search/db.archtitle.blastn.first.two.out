Blast4-archive ::= {
  request {
    body get-request-info {
      request-id "Error"
    }
  },
  results {
  },
  messages {
    {
      code 2,
      message "BLAST query error: CFastaReader: Near line 22, there's a line
 that doesn't look like plausible data, but it's not marked as defline or
 comment."
    }
  }
}
