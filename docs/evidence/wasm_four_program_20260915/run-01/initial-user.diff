+                    best_score = score_val;
+                    a_offset = a_index;
+                    b_offset = b_index;
+                }
+
+                score_gap_row -= gap_extend as i32;
+                let score_gap_col_ext = score_gap_col - (gap_extend as i32);
+                let open_gap_col = score_val - (gap_open_extend as i32);
