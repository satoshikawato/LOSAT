    set {
      class nuc-prot,
      descr { comment "older version product" },
      seq-set {
        seq {
          id { genbank { accession "AB000110", version 1 } },
          descr { title "nuc 110", molinfo { biomol genomic } },
          inst { repr raw, mol dna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
          annot { { data ftable {
            { data cdregion { frame one }, product whole genbank { accession "BAB01210", version 1 }, location int { from 2, to 20, id genbank { accession "AB000110", version 1 } } },
            { data biosrc { org { taxname "Escherichia coli" } }, location int { from 0, to 29, id genbank { accession "AB000110", version 1 } } }
          } } }
        },
        seq {
          id { genbank { accession "BAB01210", version 2 } },
          descr { molinfo { biomol peptide } },
          inst { repr raw, mol aa, length 10, seq-data ncbieaa "MKKKKKKKKK" },
          annot { { data ftable {
            { data prot { name { "probe protein 110" } }, location whole genbank { accession "BAB01210", version 2 } }
