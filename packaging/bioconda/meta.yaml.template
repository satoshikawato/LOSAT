{% set name = "losat" %}
{% set version = "0.1.0" %}

package:
  name: {{ name }}
  version: {{ version }}

source:
  url: https://github.com/satoshikawato/LOSAT/archive/refs/tags/v{{ version }}.tar.gz
  sha256: __REPLACE_WITH_V0_1_0_TAG_TARBALL_SHA256__

build:
  number: 0

requirements:
  build:
    - {{ compiler('rust') }}
    - cargo-bundle-licenses

test:
  commands:
    - LOSAT --version
    - LOSAT --help
    - LOSAT blastn --help
    - LOSAT blastp --help
    - LOSAT tblastx --help

about:
  home: https://github.com/satoshikawato/LOSAT
  license: MIT
  license_family: MIT
  license_file:
    - LICENSE
    - THIRDPARTY.yml
  summary: BLAST-compatible local sequence alignment tool implemented in Rust
  description: |
    LOSAT is a Rust implementation of BLAST-compatible local sequence alignment
    focused on certified local query/subject profiles for BLASTN, BLASTP, and
    TBLASTX. NCBI BLAST+ is used only as a validation oracle and is not a LOSAT
    runtime or build dependency.
  dev_url: https://github.com/satoshikawato/LOSAT
  doc_url: https://github.com/satoshikawato/LOSAT/blob/v{{ version }}/README.md

extra:
  additional-platforms:
    - linux-aarch64
    - osx-arm64
  recipe-maintainers:
    - satoshikawato
