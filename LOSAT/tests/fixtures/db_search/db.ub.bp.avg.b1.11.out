Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "plain",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">x1"
                  }
                }
              },
              title "x1"
            },
            inst {
              repr raw,
              mol aa,
              length 20,
              seq-data ncbieaa "XXXXXXXXXXXXXXXXXXXX"
            }
          }
        }
      },
      subject sequences {
        {
          id {
            local str "Subject_1"
          },
          descr {
            user {
              type str "CFastaReader",
              data {
                {
                  label str "DefLine",
                  data str ">s1"
                }
              }
            },
            title "s1"
          },
          inst {
            repr raw,
            mol aa,
            length 2,
            seq-data ncbieaa "MK"
          }
        },
        {
          id {
            local str "Subject_2"
          },
          descr {
            user {
              type str "CFastaReader",
              data {
                {
                  label str "DefLine",
                  data str ">s2"
                }
              }
            },
            title "s2"
          },
          inst {
            repr virtual,
            mol aa,
            length 0
          }
        },
        {
          id {
            local str "Subject_3"
          },
          descr {
            user {
              type str "CFastaReader",
              data {
                {
                  label str "DefLine",
                  data str ">s3"
                }
              }
            },
            title "s3"
          },
          inst {
            repr virtual,
            mol aa,
            length 0
          }
        }
      },
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "WordThreshold",
          value integer 11
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "UngappedMode",
          value boolean FALSE
        },
        {
          name "CompositionBasedStats",
          value integer 2
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        }
      }
    }
  },
  results {
    alignments {
    },
    masks {
    },
    ka-blocks {
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped FALSE
      },
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 0",
      "Effective search space used: 0",
      "Length adjustment: 0"
    }
  },
  messages {
    {
      code 1,
      message "Warning: [blastp] Subject_2 s2: Subject sequence contains no
 data"
    },
    {
      code 1,
      message "Warning: [blastp] Subject_3 s3: Subject sequence contains no
 data"
    }
  }
}
