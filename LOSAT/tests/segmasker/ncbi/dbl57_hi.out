Blast-db-mask-info ::= {
  algo-id 1,
  algo-program seg,
  algo-options "window=12; locut=0.5; hicut=3.14159",
  masks {
    masks {
      int {
        from 15,
        to 50,
        id local id 1
      },
      packed-int {
        {
          from 24,
          to 131,
          id local id 3
        },
        {
          from 200,
          to 255,
          id local id 3
        }
      }
    },
    more FALSE
  }
}
