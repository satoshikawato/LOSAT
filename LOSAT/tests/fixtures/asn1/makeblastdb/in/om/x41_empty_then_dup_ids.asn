Seq-entry ::= set {
  class genbank,
  seq-set {
seq {
  id { local str "s1" },
  descr {
    title "t"
  },
  inst { repr raw, mol dna, length 120, seq-data iupacna "ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT" },
  annot { { data ftable {
    { data imp { key "misc_feature" }, location mix { empty local str "X", int { from 0, to 29, id local str "s1" } } }
  } } }
},
seq {
  id { local str "s1" },
  descr {
    title "t"
  },
  inst { repr raw, mol dna, length 120, seq-data iupacna "ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT" }
}
  }
}
