+    for (q, s) in query_seq.chars().zip(subject_seq.chars()) {
+        if q == s {
+            matches += 1;
+        } else {
+            if matches > 0 {
+                btop.push_str(&matches.to_string());
+                matches = 0;
+            }
+            btop.push(q);
+            btop.push(s);
+        }
+    }
+
+    if matches > 0 {
+        btop.push_str(&matches.to_string());
+    }
+
+    btop
