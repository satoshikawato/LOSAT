<?xml version="1.0" encoding="US-ASCII"?>
<BlastXML2
    xmlns="http://www.ncbi.nlm.nih.gov"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
    xs:schemaLocation="http://www.ncbi.nlm.nih.gov http://www.ncbi.nlm.nih.gov/data_specs/schema_alt/NCBI_BlastOutput2.xsd"
>
<BlastOutput2>
  <report>
    <Report>
      <program>blastx</program>
      <version>BLASTX 2.17.0+</version>
      <reference>Stephen F. Altschul, Thomas L. Madden, Alejandro A. Sch&amp;auml;ffer, Jinghui Zhang, Zheng Zhang, Webb Miller, and David J. Lipman (1997), &quot;Gapped BLAST and PSI-BLAST: a new generation of protein database search programs&quot;, Nucleic Acids Res. 25:3389-3402.</reference>
      <search-target>
        <Target>
          <db>tests/db_search/multidb/pf3p tests/db_search/multidb/pf3u</db>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <matrix>BLOSUM62</matrix>
          <expect>1e-10</expect>
          <gap-open>11</gap-open>
          <gap-extend>1</gap-extend>
          <filter>L;</filter>
          <cbs>2</cbs>
          <query-gencode>1</query-gencode>
        </Parameters>
      </params>
      <results>
        <Results>
          <search>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>q0_nohit a query without hits</query-title>
              <query-len>118</query-len>
              <query-masking>
                <Range>
                  <from>15</from>
                  <to>96</to>
                </Range>
                <Range>
                  <from>7</from>
                  <to>100</to>
                </Range>
                <Range>
                  <from>26</from>
                  <to>71</to>
                </Range>
                <Range>
                  <from>77</from>
                  <to>104</to>
                </Range>
              </query-masking>
              <hits></hits>
              <stat>
                <Statistics>
                  <db-num>2</db-num>
                  <db-len>245</db-len>
                  <hsp-len>9</hsp-len>
                  <eff-space>6810</eff-space>
                  <kappa>0.041</kappa>
                  <lambda>0.267</lambda>
                  <entropy>0.14</entropy>
                </Statistics>
              </stat>
              <message>No hits found</message>
            </Search>
          </search>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>
</BlastXML2>
