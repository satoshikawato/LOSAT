      data {
        {
          label str "tblastx",
          data int 5
        }
      }
    },
    user {
      type str "Blast Database Title",
      data {
        {
          label str "nrefuse_v5 (parsed Seq-ids)",
          data bool TRUE
        }
      }
    }
  },
  data align {
    {
      type diags,
      segs std {
        {
          dim 2,
