          inst { repr raw, mol dna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
          annot { { data ftable {
            { data cdregion { frame one }, product whole genbank { accession "BAA00100", version 1 }, location int { from 2, to 20, id embl { accession "AB001100", version 1 } } },
            { data biosrc { org { taxname "Escherichia coli" } }, location int { from 0, to 29, id genbank { accession "AB001100", version 1 } } }
          } } }
