TSDQQMFSPIHKLLPYTNSIVKLASKCMICKIDTKEAPFTVRFGNDNDNNVICVGGAEMYAAACRDCYKKINKKKNKG
KLVVLEGGDRCGKSTQAKLLLTNKNSPLYGGEYMCFPDRSSHTGKLINDYLTKKIELDDHAAHLLFSANRWEVCSKIK
QLLDDGIHVVMDRYYYSGIVFSLARGVDTVEWCSASDEGLPQPDLVLLMLLDVEKCSNRDTFGVERFETNSIQERARA
LFLDLANKDEKNVWIKVDARGTIEEVQTKIINIVYNIVEE"
            }
          }
        }
      },
      subject database "rps_mini",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, -5 }
        },
        {
          name "MaskAtHash",
