<?xml version="1.0"?>
<ncbi_application xmlns="ncbi:application"
 xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
 xs:schemaLocation="ncbi:application ncbi_application.xsd"
>
<program type="regular">
<name>blastdb_aliastool</name>
<version>2.17.0</version>
<description>Application to create BLAST database aliases, version 2.17.0+&#xa;&#xa;This application has three modes of operation:&#xa;&#xa;1) GI file conversion:&#xa;   Converts a text file containing GIs (one per line) to a more efficient&#xa;   binary format. This can be provided as an argument to the -gilist option&#xa;   of the BLAST search command line binaries or to the -gilist option of&#xa;   this program to create an alias file for a BLAST database (see below).&#xa;&#xa;2) Alias file creation (restricting with GI List or Sequence ID List):&#xa;   Creates an alias for a BLAST database and a GI or ID list which&#xa;   restricts this database. This is useful if one often searches a subset&#xa;   of a database (e.g., based on organism or a curated list). The alias&#xa;   file makes the search appear as if one were searching a regular BLAST&#xa;   database rather than the subset of one.&#xa;&#xa;3) Alias file creation (aggregating BLAST databases):&#xa;   Creates an alias for multiple BLAST databases. All databases must be of&#xa;   the same molecule type (no validation is done). The relevant options are&#xa;   -dblist and -num_volumes.&#xa;</description>
<detailed_description></detailed_description>
</program>
<arguments>
<key name="db" type="String" optional="true">
<description>BLAST database name</description>
<group>2</group>
<synopsis>dbname</synopsis>
</key>
<key name="dblist" type="String" optional="true">
<description>A space separated list of BLAST database names to aggregate</description>
<group>2</group>
<synopsis>database_names</synopsis>
</key>
<key name="dblist_file" type="File_In" optional="true">
<description>A file containing a list of BLAST database names to aggregate, one per line</description>
<group>2</group>
<synopsis>file_name</synopsis>
</key>
<key name="dbtype" type="String" optional="true">
<description>Molecule type stored in BLAST database</description>
<group>2</group>
<synopsis>molecule_type</synopsis>
<constraint>
<description>`nucl&apos;, `prot&apos;</description>
<Strings case_sensitive="true">
<value>nucl</value>
<value>prot</value>
</Strings>
</constraint>
<default>prot</default>
</key>
<key name="gi_file_in" type="File_In" optional="true">
<description>Text file to convert, should contain one GI per line</description>
<group>1</group>
<synopsis>input_file</synopsis>
</key>
<key name="gi_file_out" type="File_Out" optional="true">
<description>File name of converted GI file&#xa;Default = input file name provided to -gi_file_in argument with the .bgl extension</description>
<group>1</group>
<synopsis>output_file</synopsis>
<flags><preOpen/><binary/></flags>
</key>
<key name="gilist" type="File_In" optional="true">
<description>Text or binary gi file to restrict the BLAST database provided in -db argument&#xa;If text format is provided, it will be converted to binary</description>
<group>2</group>
<synopsis>input_file</synopsis>
</key>
<key name="logfile" type="File_Out" optional="true">
<description>File to which the program log should be redirected</description>
<group>3</group>
<synopsis>File_Name</synopsis>
</key>
<key name="num_volumes" type="Integer" optional="true">
<description>Number of volumes to aggregate, in which case the basename for the database is extracted from the out option</description>
<group>2</group>
<synopsis>positive_integer</synopsis>
<constraint>
<description>&gt;=1</description>
</constraint>
</key>
<key name="oid_masks" type="Integer" optional="true">
<description>Create alias db with pre-built oid masks&#xa;0x01 Exclude Model</description>
<group>2</group>
<synopsis>oid_masks</synopsis>
</key>
<key name="out" type="String" optional="true">
<description>Name of BLAST database alias to be created</description>
<group>2</group>
<synopsis>database_name</synopsis>
</key>
<key name="seqid_db" type="String" optional="true">
<description>BLAST database for seqidlist</description>
<group>3</group>
<synopsis>dbname</synopsis>
</key>
<key name="seqid_dbtype" type="String" optional="true">
<description>Molecule type BLAST database</description>
<group>3</group>
<synopsis>molecule_type</synopsis>
<constraint>
<description>`nucl&apos;, `prot&apos;</description>
<Strings case_sensitive="true">
<value>nucl</value>
<value>prot</value>
</Strings>
</constraint>
</key>
<key name="seqid_file_in" type="File_In" optional="true">
<description>Text file to convert, should contain one seq id per line</description>
<group>3</group>
<synopsis>input_file</synopsis>
</key>
<key name="seqid_file_info" type="String" optional="true">
<description>Display seqidlist file info</description>
<group>3</group>
<synopsis>seqid_file_info</synopsis>
</key>
<key name="seqid_file_out" type="String" optional="true">
<description>File name of converted seq id file&#xa;Default = input file name provided to -seqid_file_in argument with the .bsl extension</description>
<group>3</group>
<synopsis>output_file</synopsis>
</key>
<key name="seqid_title" type="String" optional="true">
<description>Title for seqid list.&#xa; Default = input file name provided to -seqid_file_in argument</description>
<group>3</group>
<synopsis>seqid_title</synopsis>
</key>
<key name="seqidlist" type="File_In" optional="true">
<description>Text sequence id or accession file to restrict the BLAST database provided in -db argument</description>
<group>2</group>
<synopsis>input_file</synopsis>
</key>
<key name="taxidlist" type="File_In" optional="true">
<description>Text taxonomy id file to restrict the BLAST database provided in -db argument</description>
<group>2</group>
<synopsis>input_file</synopsis>
</key>
<key name="title" type="String" optional="true">
<description>Title for BLAST database&#xa;Default = name of BLAST database provided to -db argument with the -gifile argument appended to it</description>
<group>2</group>
<synopsis>database_title</synopsis>
</key>
<key name="vdblist" type="String" optional="true">
<description>A space separated list of VDB names to aggregate</description>
<group>2</group>
<synopsis>vdb_names</synopsis>
</key>
<key name="vdblist_file" type="File_In" optional="true">
<description>A file containing a list of vdb names to aggregate, one per line</description>
<group>2</group>
<synopsis>file_name</synopsis>
</key>
<flag name="h" optional="true">
<description>Print USAGE and DESCRIPTION;  ignore all other parameters</description>
</flag>
<flag name="help" optional="true">
<description>Print USAGE, DESCRIPTION and ARGUMENTS; ignore all other parameters</description>
</flag>
<flag name="version" optional="true">
<description>Print version number;  ignore other arguments</description>
</flag>
