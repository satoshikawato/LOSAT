+        let q_sub = &q_seq[..len1.min(q_seq.len())];
+        let s_sub = &s_seq[..len2.min(s_seq.len())];
+
+        return extend_gapped_one_direction_with_traceback_with_scratch(
+            q_sub,
+            s_sub,
+            reward,
+            penalty,
+            score_matrix,
+            gap_open,
+            gap_extend,
+            x_drop,
+            gap_scratch,
