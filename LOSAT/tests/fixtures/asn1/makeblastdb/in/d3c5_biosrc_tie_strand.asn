Bioseq-set ::= {
  seq-set {
    set {
      class nuc-prot,
      descr { source { org { taxname "Escherichia coli" } } },
      seq-set {
        seq {
          id { local str "n_p5b" },
          inst { repr raw, mol dna, length 700, seq-data iupacna "" },
          annot { { data ftable {
            { data biosrc { org { taxname "Org B" } }, location int { from 200, to 600, id local str "n_p5b" } },
            { data biosrc { org { taxname "Org A" } }, location int { from 100, to 500, id local str "n_p5b" } }
          } } }
        },
        seq {
          id { local str "p5b" },
          inst { repr raw, mol aa, length 4, seq-data ncbieaa "MKPF" },
          annot { { data ftable { { data prot { name { "kinase" } }, location int { from 0, to 3, id local str "p5b" } } } } }
        }
      },
      annot { { data ftable {
        { data cdregion {}, product whole local str "p5b", location int { from 250, to 450, id local str "n_p5b" } }
      } } }
    },
    set {
