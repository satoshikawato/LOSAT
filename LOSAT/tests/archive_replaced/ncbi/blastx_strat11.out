          },
          inst {
            repr raw,
            mol aa,
            length 50,
            seq-data ncbieaa "MGPDESREAQKMDRNPLYSVRFGKAIEDDKDTPFDHQMDVYQTTPLEC
IL"
          }
        }
      },
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "LongestIntronLength",
          value integer 0
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFilteringWindow",
          value integer 12
        },
        {
          name "SegFilteringLocut",
          value real { 22, 10, -1 }
        },
        {
          name "SegFilteringHicut",
          value real { 25, 10, -1 }
        },
        {
          name "WordThreshold",
          value integer 12
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "UngappedMode",
          value boolean FALSE
        },
        {
          name "QueryGeneticCode",
          value integer 1
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "CompositionBasedStats",
          value integer 2
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 5088
        }
      }
    }
  },
  results {
    alignments {
      {
        type partial,
        dim 2,
        score {
          {
            id str "score",
            value int 320
          },
          {
            id str "blast_score",
            value int 320
          },
          {
            id str "e_value",
            value real { 329279859707269, 10, -60 }
          },
          {
            id str "bit_score",
            value real { 127872096573597, 10, -12 }
          },
          {
            id str "num_ident",
            value int 60
          },
          {
            id str "comp_adjustment_method",
            value int 2
          },
          {
            id str "num_positives",
            value int 60
          },
          {
            id str "hsp_percent_coverage",
            value real { 1, 10, 2 }
          }
        },
        segs std {
          {
            dim 2,
            ids {
              local str "Query_1",
              local str "Subject_1"
            },
            loc {
              int {
                from 0,
                to 179,
                strand plus,
                id local str "Query_1"
              },
              int {
                from 0,
                to 59,
                strand unknown,
                id local str "Subject_1"
              }
            }
          }
        }
      }
    },
    masks {
    },
    ka-blocks {
      {
        lambda { 317605957635731, 10, -15 },
        k { 133956144488482, 10, -15 },
