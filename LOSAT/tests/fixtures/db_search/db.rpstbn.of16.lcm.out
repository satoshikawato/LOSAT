      <search-target>
        <Target>
          <db>rps_mini</db>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <matrix>BLOSUM62</matrix>
          <expect>0.001</expect>
          <gap-open>11</gap-open>
          <gap-extend>1</gap-extend>
          <filter>F</filter>
          <cbs>1</cbs>
          <query-gencode>1</query-gencode>
        </Parameters>
      </params>
      <results>
        <Results>
          <search>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>stopq</query-title>
              <query-len>600</query-len>
              <hits></hits>
              <stat>
                <Statistics>
                  <db-num>3</db-num>
                  <db-len>560</db-len>
                  <hsp-len>27</hsp-len>
                  <eff-space>82388</eff-space>
                  <kappa>0.041</kappa>
                  <lambda>0.267</lambda>
                  <entropy>0.14</entropy>
                </Statistics>
              </stat>
              <message>No hits found</message>
            </Search>
          </search>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>

