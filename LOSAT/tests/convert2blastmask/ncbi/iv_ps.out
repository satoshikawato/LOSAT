Blast-db-mask-info ::= {
  algo-id 0,
  algo-program dust,
  algo-options "o",
  masks {
    masks {
      packed-int {
        {
          from 10,
          to 20,
          id local str "s1"
        },
        {
          from 30,
          to 40,
          id local str "s1"
        },
        {
          from 5,
          to 7,
          id local str "s1"
        }
      }
    },
    more FALSE
  }
}
