+            let sc = get_s(s_seq, b_index, len2, reverse);
+            // NCBI reference: ncbi-blast/c++/src/algo/blast/core/blast_gapalign.c:569-575
+            // ```c
+            // if (matrix_index == FENCE_SENTRY) {
+            //     if (fence_hit) { *fence_hit = 1; }
+            //     break;
+            // }
+            // ```
+            if sc == FENCE_SENTRY {
