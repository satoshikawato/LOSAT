<BlastOutput2>
  <report>
    <Report>
      <program>phiblastp</program>
      <version>PHIBLASTP 2.17.0+</version>
      <reference>Zheng Zhang, Alejandro A. Sch&amp;auml;ffer, Webb Miller, Thomas L. Madden, David J. Lipman, Eugene V. Koonin, and Stephen F. Altschul (1998), &quot;Protein sequence similarity searches using patterns as seeds&quot;, Nucleic Acids Res. 26:3986-3990.</reference>
      <search-target>
        <Target>
          <db>tests/db_search/paja</db>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <matrix>PAM250</matrix>
          <expect>10</expect>
          <gap-open>15</gap-open>
          <gap-extend>2</gap-extend>
          <filter>F</filter>
          <pattern>[AG]-x(4)-G-K-[ST]</pattern>
        </Parameters>
      </params>
      <results>
        <Results>
          <search>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>YP_009220601.1 TK-TMK, chimeric thymidine and thymidylate kinase [White spot syndrome virus]</query-title>
