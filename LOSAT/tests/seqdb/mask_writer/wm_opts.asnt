Blast-db-mask-info ::= {
  algo-id 0,
  algo-program windowmasker,
  algo-options "-t_extend 3",
  masks {
    masks {
      packed-int {
          {
            from 5,
            to 14,
            id local id 3
          }
      },
      packed-int {
          {
            from 0,
            to 99,
            id local id 6
          }
      }
    },
    more FALSE
  }
}
