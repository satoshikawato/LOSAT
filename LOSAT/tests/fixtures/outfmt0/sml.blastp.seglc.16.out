<?xml version="1.0" encoding="US-ASCII"?>
<BlastXML2
    xmlns="http://www.ncbi.nlm.nih.gov"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
    xs:schemaLocation="http://www.ncbi.nlm.nih.gov http://www.ncbi.nlm.nih.gov/data_specs/schema_alt/NCBI_BlastOutput2.xsd"
>
<BlastOutput2>
  <report>
    <Report>
      <program>blastp</program>
      <version>BLASTP 2.17.0+</version>
      <reference>Stephen F. Altschul, Thomas L. Madden, Alejandro A. Sch&amp;auml;ffer, Jinghui Zhang, Zheng Zhang, Webb Miller, and David J. Lipman (1997), &quot;Gapped BLAST and PSI-BLAST: a new generation of protein database search programs&quot;, Nucleic Acids Res. 25:3389-3402.</reference>
      <search-target>
        <Target>
          <subjects>Subject_1</subjects>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <matrix>BLOSUM62</matrix>
          <expect>10</expect>
          <gap-open>11</gap-open>
          <gap-extend>1</gap-extend>
          <filter>L;</filter>
          <cbs>2</cbs>
        </Parameters>
      </params>
      <results>
        <Results>
          <bl2seq>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>qs1 low-complexity run inside the alignment lower over part of the Q run and at 80-95</query-title>
              <query-len>119</query-len>
              <query-masking>
                <Range>
                  <from>27</from>
                  <to>53</to>
                </Range>
                <Range>
                  <from>80</from>
                  <to>94</to>
                </Range>
              </query-masking>
              <hits>
                <Hit>
                  <num>1</num>
                  <description>
                    <HitDescr>
                      <id>ss1</id>
                      <title>ss1 subject with the same run</title>
                    </HitDescr>
                  </description>
                  <len>116</len>
                  <hsps>
                    <Hsp>
                      <num>1</num>
                      <bit-score>133.65</bit-score>
                      <score>335</score>
                      <evalue>9.24468e-47</evalue>
                      <identity>109</identity>
                      <positive>110</positive>
                      <query-from>1</query-from>
                      <query-to>119</query-to>
                      <hit-from>1</hit-from>
                      <hit-to>116</hit-to>
                      <align-len>119</align-len>
                      <gaps>3</gaps>
                      <qseq>MWMEHSVLKANFAVLRKVMDDPKIRDGpmavmkqqqqqqqqqqqqqqqqqqqqqGWENYCWPANMSWKVLMKYEFSSDIHpcnlwicwipkematPGWWNTDTLHMSEMGLWMHKYPKC</qseq>
                      <hseq>MWMEHSVLKAVFAVRRKVMDDPKIRDGPMAVMKQQQQQQQQQQQQQQQQQQQQQGWENYCWPANMSWKVLMKYEFSSDIH---PWICWIPKEQQTPGWWKTDTLHMAEMGLWMHKYPKC</hseq>
                      <midline>MWMEHSVLKA FAV RKVMDDPKIRDGPMAVMKQQQQQQQQQQQQQQQQQQQQQGWENYCWPANMSWKVLMKYEFSSDIH    WICWIPKE  TPGWW TDTLHM+EMGLWMHKYPKC</midline>
                    </Hsp>
                  </hsps>
                </Hit>
              </hits>
              <stat>
                <Statistics>
                  <hsp-len>13</hsp-len>
                  <eff-space>10918</eff-space>
                  <kappa>0.041</kappa>
                  <lambda>0.267</lambda>
                  <entropy>0.14</entropy>
                </Statistics>
              </stat>
            </Search>
          </bl2seq>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>

