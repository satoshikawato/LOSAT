Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "tblastx",
      service "plain",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">q1 first query"
                  }
                }
              },
              title "q1 first query"
            },
            inst {
              repr raw,
              mol na,
              length 180,
              seq-data ncbi2na '39EED933F0A147E4D28BA66454330F79AE5186D755D1A6
FB94187684EE84C613BD0798627530AA842993825112'H
            }
          }
        }
      },
      subject database "tests/db_search/arch_tbx_snucl",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "LongestIntronLength",
          value integer 0
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFilteringWindow",
          value integer 12
        },
        {
          name "SegFilteringLocut",
          value real { 22, 10, -1 }
        },
        {
          name "SegFilteringHicut",
          value real { 25, 10, -1 }
        },
        {
          name "WordThreshold",
          value integer 13
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "QueryGeneticCode",
          value integer 1
        },
        {
          name "DbGeneticCode",
          value integer 1
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 7191
        }
      }
    }
  },
  results {
    alignments {
      {
        type diags,
        segs std {
          {
            dim 2,
            ids {
              local str "Query_1",
              general {
                db "BL_ORD_ID",
                tag id 0
              }
            },
            loc {
              int {
                from 12,
                to 62,
                strand minus,
                id local str "Query_1"
              },
              int {
                from 123,
                to 173,
                strand plus,
                id general {
                  db "BL_ORD_ID",
                  tag id 0
                }
              }
            },
            scores {
              {
                id str "score",
                value int 30
              },
              {
                id str "blast_score",
                value int 30
              },
              {
                id str "e_value",
                value real { 140199504595269, 10, -15 }
              },
              {
                id str "bit_score",
                value real { 166464235377637, 10, -13 }
              },
              {
                id str "num_ident",
                value int 6
              },
              {
                id str "num_positives",
                value int 11
              },
              {
                id str "hsp_percent_coverage",
                value real { 994444444444444, 10, -14 }
              }
            }
          },
          {
            dim 2,
            ids {
              local str "Query_1",
              general {
                db "BL_ORD_ID",
                tag id 0
              }
            },
            loc {
              int {
                from 88,
                to 108,
                strand minus,
                id local str "Query_1"
              },
              int {
                from 9,
                to 29,
                strand minus,
                id general {
                  db "BL_ORD_ID",
                  tag id 0
                }
              }
            },
            scores {
              {
                id str "score",
                value int 23
              },
              {
                id str "blast_score",
                value int 23
              },
              {
                id str "e_value",
                value real { 126750025831751, 10, -14 }
              },
              {
                id str "bit_score",
                value real { 134389637574987, 10, -13 }
              },
              {
                id str "num_ident",
                value int 4
              },
              {
                id str "num_positives",
                value int 6
              },
              {
                id str "hsp_percent_coverage",
                value real { 438888888888889, 10, -14 }
              }
            }
          }
        }
      }
    },
    masks {
      {
        locations {
          packed-int {
            {
              from 100,
              to 145,
              id local str "Query_1"
            }
          }
        },
        frame plus2
      },
      {
        locations {
          packed-int {
            {
              from 102,
              to 140,
              id local str "Query_1"
            }
          }
        },
        frame minus1
      }
    },
    ka-blocks {
      {
        lambda { 317605957635731, 10, -15 },
        k { 133956144488482, 10, -15 },
        h { 401214524497119, 10, -15 },
        gapped FALSE
      },
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 7191",
      "Effective search space used: 7191",
      "Length adjustment: 13"
    }
  }
}
