        }
      }
    }
  },
  results {
    alignments {
      {
        type partial,
        dim 2,
        score {
          {
            id str "score",
            value int 180
          },
          {
            id str "blast_score",
            value int 180
          },
          {
            id str "e_value",
            value real { 213039387878148, 10, -110 }
          },
          {
            id str "bit_score",
            value real { 333517231654535, 10, -12 }
          },
          {
            id str "num_ident",
            value int 180
          },
          {
            id str "hsp_percent_coverage",
            value real { 1, 10, 2 }
          }
        },
        segs denseg {
          dim 2,
          numseg 1,
          ids {
            local str "Query_1",
            local str "Subject_1"
          },
