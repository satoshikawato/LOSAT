Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "rpsblast",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">NP_414546.1 DUF2502 domain-containing protein
 YaaX [Escherichia coli str. K-12 substr. MG1655]"
                  }
                }
              },
              title "NP_414546.1 DUF2502 domain-containing protein YaaX
 [Escherichia coli str. K-12 substr. MG1655]"
            },
            inst {
              repr raw,
              mol aa,
              length 98,
              seq-data ncbieaa "MKKMQSIVLALSLVLVAPMAAQAAEITLVPSVKLQIGDRDNRGYYW
DGGHWRDHGWWKQHYEWRGNRWHLHGPPPPPRHHKKAPHDHHGGHGPGKHHR"
            }
          }
        }
      },
      subject database "Cdd",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, -2 }
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "CompositionBasedStats",
          value integer 1
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        },
        {
          name "DbLength",
          value big-integer 15821058
        },
        {
          name "MatrixName",
          value string "BLOSUM62"
        },
        {
          name "GapOpeningCost",
          value integer 11
        },
        {
          name "GapExtensionCost",
          value integer 1
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 396882150
        }
      }
    }
  },
  results {
    alignments {
      {
        type partial,
        dim 2,
        score {
          {
            id str "score",
            value int 142
          },
          {
            id str "blast_score",
            value int 142
          },
          {
            id str "e_value",
            value real { 598936497866175, 10, -27 }
          },
          {
            id str "bit_score",
            value real { 588715007490614, 10, -13 }
          },
          {
            id str "num_ident",
            value int 29
          },
          {
            id str "comp_adjustment_method",
            value int 1
          },
          {
            id str "num_positives",
            value int 33
          },
          {
            id str "hsp_percent_coverage",
            value real { 494795918367347, 10, -13 }
          }
        },
        segs denseg {
          dim 2,
          numseg 3,
          ids {
            local str "Query_1",
            general {
              db "CDD",
              tag id 491353
            }
          },
          starts {
            24,
            0,
            -1,
            36,
            60,
            48
          },
          lens {
            36,
            12,
            12
          },
          strands {
            unknown,
            unknown,
            unknown,
            unknown,
            unknown,
            unknown
          }
        }
      }
    },
    masks {
    },
    ka-blocks {
      {
        lambda { 32095968080592, 10, -14 },
        k { 139428490684625, 10, -15 },
        h { 512215053439896, 10, -15 },
        gapped FALSE
      },
      {
        lambda { 267, 10, -3 },
        k { 41, 10, -3 },
        h { 14, 10, -2 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 396882150",
      "Effective search space used: 396882150",
      "Length adjustment: 63"
    }
  }
