+                // ```c
+                // static void s_ReduceGaps(GapEditScript* esp, const Uint1 *q,
+                //                         const Uint1 *s, const Uint1 *qf,
+                //                         const Uint1 *sf) { ... }
+                // ```
+                eprintln!(
+                    "[GREEDY_TRACEBACK] start=({}, {}) post_reduce={}",
