Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "plain",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">q1 first query"
                  }
                }
              },
              title "q1 first query"
            },
            inst {
              repr raw,
              mol aa,
              length 60,
              seq-data ncbieaa "MLCRIFKDHLHQEWRAPNIILRCHDVLPSRRCANDSDMWTYDMFNC
DELHKGDKAHEATQ"
            }
          }
        }
      },
      subject database "tests/db_search/arch_sprot",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "WordThreshold",
          value integer 11
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "UngappedMode",
          value boolean FALSE
        },
        {
          name "CompositionBasedStats",
          value integer 2
        },
        {
          name "SmithWatermanMode",
          value boolean FALSE
        },
        {
          name "EffectiveSearchSpace",
          value big-integer 11891
        }
      }
    }
  },
  results {
    alignments {
    },
    masks {
    },
    ka-blocks {
      {
        lambda { 327139349774452, 10, -15 },
        k { 137486015136503, 10, -15 },
        h { 488124195906768, 10, -15 },
        gapped FALSE
      },
      {
        lambda { 267, 10, -3 },
        k { 41, 10, -3 },
        h { 14, 10, -2 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 11891",
      "Effective search space used: 11891",
      "Length adjustment: 13"
    }
  }
}
