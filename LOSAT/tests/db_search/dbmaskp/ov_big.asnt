Blast-db-mask-info ::= {
  algo-id 2,
  algo-program seg,
  algo-options "overlap big",
  masks {
    masks {
      packed-int {
        {
          from 40,
          to 119,
          id local id 1
        },
        {
          from 60,
          to 129,
          id local id 1
        }
      }
    },
    more FALSE
  }
}
