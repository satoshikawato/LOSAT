Blast4-request ::= {
  body queue-search {
    program "blastp",
    service "plain",
    queries bioseq-set {
      seq-set {
        seq {
          id {
            local str "Query_1"
          },
          descr {
            user {
              type str "CFastaReader",
              data {
                {
                  label str "DefLine",
                  data str ">YP_009220477.1 hypothetical protein [White spot
 syndrome virus]"
                }
              }
            },
            title "YP_009220477.1 hypothetical protein [White spot syndrome
 virus]"
          },
          inst {
            repr raw,
            mol aa,
            length 104,
            seq-data ncbieaa "MYLSHIRQTPLVEERRALTFKMYHHNNNNQHSFVNCQCRRTSSSINCS
SCSRETFNSVKAIQYFNKTSRNNTAHHFKMPASKDRNYSSFEYAETAVAAHNISQW"
          }
        }
      }
    },
    subject sequences {
      {
        id {
          local str "Subject_1"
        },
        descr {
          user {
            type str "CFastaReader",
            data {
              {
                label str "DefLine",
                data str ">slc lower"
              }
            }
          },
          title "slc lower"
        },
        inst {
          repr raw,
          mol aa,
          length 196,
          seq-data ncbieaa "MDVSSYKSTIDYHNIEDMDDLQRATYKDRMETELVLEMAKKEGRYVRSLA
TMDELEVPEEPATCYTCGYTFIRRRAPPPKRKSIFREPCAYPELLPDAPSPVRLEELVDVPEGASFFTYPPYDDGSST
SSSQAECEDDYPPPYDPSENPQRSQVCDYCTTRQVLSSMTDHARANLIKNLKREKKALGLGRRNNFSY"
        }
      }
    },
    algorithm-options {
      {
        name "EvalueThreshold",
        value cutoff e-value { 1, 10, 3 }
      },
      {
        name "MaskAtHash",
        value boolean FALSE
      },
      {
        name "SegFiltering",
        value boolean FALSE
      },
      {
        name "WordThreshold",
        value integer 11
      },
      {
        name "WindowSize",
        value integer 40
      },
      {
        name "HitlistSize",
        value integer 500
      },
      {
        name "GapTrigger",
        value real { 22, 10, 0 }
      },
      {
        name "IgnoreMsaMaster",
        value boolean FALSE
      },
      {
        name "PseudoCountWeight",
        value integer 0
      },
      {
        name "InclusionThreshold",
        value real { 2, 10, -3 }
      },
      {
        name "PHIPattern",
        value string "C-x(2)-C"
      }
    }
  }
}
