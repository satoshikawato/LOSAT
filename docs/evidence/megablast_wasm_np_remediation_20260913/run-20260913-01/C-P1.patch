+                subject[fence_index] = FENCE_SENTRY;
+                let mut scratch = GapAlignScratch::new();
+                scratch.trace_rows = vec![vec![u8::MAX; capacity]; 2];
+                scratch.trace_offsets = vec![0; 2];
