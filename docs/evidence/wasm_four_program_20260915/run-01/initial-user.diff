+/// Affine traceback helper from match state.
+/// NCBI reference: ncbi-blast/c++/src/algo/blast/core/greedy_align.c:148-178
+fn get_next_affine_tback_from_match(
+    last_seq2_off: &[Vec<GreedyOffset>],
+    diag_lower: &[i32],
+    diag_upper: &[i32],
+    diag_offset: i32,
+    d: &mut i32,
+    diag: i32,
+    op_cost: i32,
+    seq2_index: &mut i32,
