Seq-entry ::= set {
  class segset,
  descr { source { org { taxname "Homo sapiens" } }, molinfo { biomol genomic } },
  seq-set {
    seq {
      id { genbank { accession "AB001350", version 1 } },
      inst { repr seg, mol dna, length 30, ext seg { whole genbank { accession "AB001351", version 2 } } }
    },
    set {
      class parts,
      seq-set {
        seq {
          id { genbank { accession "AB001351", version 1 } },
          descr { title "part 135" },
          inst { repr raw, mol dna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
          annot { { data ftable {
            { data cdregion { frame one }, location int { from 0, to 29, id genbank { accession "AB001351", version 1 } }, xref { { data prot { name { "segprot 135" } } }, { data gene { locus "SEGG135" } } } }
          } } }
        }
      }
    }
  }
}
