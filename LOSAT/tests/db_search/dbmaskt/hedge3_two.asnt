Blast-db-mask-info ::= {
  algo-id 2,
  algo-program windowmasker,
  algo-options "hedge3 two",
  masks {
    masks {
      packed-int {
        {
          from 0,
          to 2,
          id local id 4
        },
        {
          from 1200,
          to 1200,
          id local id 4
        }
      }
    },
    more FALSE
  }
}
