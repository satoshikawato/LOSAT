Seq-annot ::= {
  desc {
    user {
      type str "Hist Seqalign",
      data {
        {
          label str "Hist Seqalign",
          data bool TRUE
        }
      }
    },
    user {
      type str "Blast Type",
      data {
        {
          label str "tblastn",
          data int 4
        }
      }
    },
    user {
      type str "Blast Database Title",
      data {
        {
          label str "n/a",
          data bool FALSE
        }
      }
    }
  },
  data align {
    {
      type partial,
      dim 2,
      score {
        {
          id str "score",
          value int 550
        },
        {
          id str "blast_score",
          value int 550
        },
        {
          id str "e_value",
          value real { 132452400973603, 10, -94 }
        },
        {
          id str "bit_score",
          value real { 216467999034588, 10, -12 }
        },
        {
          id str "num_ident",
          value int 104
        },
        {
          id str "num_positives",
          value int 104
        },
        {
          id str "hsp_percent_coverage",
          value real { 1, 10, 2 }
        }
      },
      segs std {
        {
          dim 2,
          ids {
            local str "Query_1",
            local str "Subject_1"
          },
          loc {
            int {
              from 0,
              to 111,
              strand unknown,
              id local str "Query_1"
            },
            int {
              from 2,
              to 337,
              strand plus,
              id local str "Subject_1"
            }
          }
        }
      }
    }
  }
}
