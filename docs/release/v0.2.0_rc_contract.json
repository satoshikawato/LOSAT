  "certification_set": [
    {
      "id": "A",
      "title": "Gate A v0.1.1, Linux x64 native and serial Wasm",
      "cases": "43 native (blastn 14 / blastp 9 / tblastx 20) + 41 serial-Wasm equalities",
      "comparator": "mixed",
      "comparator_note": "NCBI executed for the native pairs (blastp 9 x 3 repeats, tblastx 20 x repeats); serial Wasm = raw-byte equality with native",
      "tool": "LOSAT/tests/certify_integrated_runtime_v010.py --expected-sha C",
      "where": "local",
      "expected_duration": "3-5.6 h",
      "evidence_key": "local_evidence.A"
    },
    {
      "id": "B",
      "title": "Native platform certification",
      "cases": "43 cases x 4 platforms (Windows x64, macOS arm64, macOS x64, Linux aarch64) + 6 NCBI reference executions + 12 repeats per platform",
      "comparator": "mixed",
      "comparator_note": "NCBI executed on each platform for the 6 representatives (variance bounded by ncbi_platform_variance_v011.json); 43 LOSAT outputs = canonical hashes",
      "tool": "platform-native-certification.yml (candidate_sha=C)",
      "where": "github",
      "expected_duration": "22 min - 3.5 h",
      "evidence_key": "runs.B"
    },
    {
      "id": "C",
      "title": "Cross-platform and thread equality",
      "cases": "platform_check_cases.json x 5 platforms x 1 and 4 threads; arm64 also LOSAT_X_DPNEON2=0; cargo test --all-features on four platforms",
