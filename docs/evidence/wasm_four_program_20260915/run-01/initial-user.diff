+/// Calculate initial scan step based on word size
+pub fn calculate_initial_scan_step(effective_word_size: usize, user_scan_step: usize) -> usize {
+    if user_scan_step > 0 {
+        user_scan_step
+    } else {
+        if effective_word_size >= 16 {
+            4
+        } else if effective_word_size >= 11 {
+            2
+        } else {
+            1
+        }
+    }
+}
