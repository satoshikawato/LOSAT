      annot { { data ftable {
        { data gene { locus-tag "LTORF" }, location int { from 0, to 29, id other { accession "NM_000406", version 1 } } },
        { data cdregion { orf TRUE }, location mix { packed-int { { from 0, to 9, strand minus, id other { accession "NM_000406", version 1 } }, { from 20, to 29, strand minus, id gi 900406 } } } }
