Bioseq-set ::= {
  class genbank,
  seq-set {
    seq {
      id { other { accession "NM_000500", version 1 } },
      descr { molinfo { biomol mRNA }, source { org { taxname "Homo sapiens" } } },
      inst { repr raw, mol rna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
      annot { { data ftable {
        { data gene { locus "GENE500" }, location int { from 0, to 29, id other { accession "NM_000500", version 1 } } },
        { data cdregion { frame one }, product whole genbank { accession "BAA00500", version 1 }, location int { from 0, to 29, id other { accession "NM_000500", version 1 } } }
      } } }
    },
    seq {
      id { genbank { accession "BAA00500", version 1 } },
      descr { molinfo { biomol peptide } },
      inst { repr seg, mol aa, length 10, ext seg { whole genbank { accession "BAA00599", version 1 } } }
    }
  }
}
