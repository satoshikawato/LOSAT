+        let mut links = Vec::new();
+        let log_k = vec![params.k.ln(); contexts.len()];
+        for start in [0, 8] {
+            let mut group = hits[start..start + 4].to_vec();
+            for (id, hit) in group.iter_mut().enumerate() {
+                hit.link_id = id;
+                hit.e_value = -1.0;
+            }
