PssmWithParameters ::= {
  pssm {
    isProtein TRUE,
    numRows 28,
    numColumns 30,
    byRow FALSE,
    query seq {
      id {
        local str "Query_1"
      },
      descr {
        title "rnd random"
      },
      inst {
        repr raw,
        mol aa,
        length 30,
        seq-data ncbistdaa '0C1414080E0A0F031610140D0C0806140F030E16100714120C
080A14160F'H
      }
    }
  },
  params {
    pseudocount 0,
    rpsdbparams {
      matrixName "BLOSUM62",
      gapOpen 11,
      gapExtend 1
    }
  }
}
