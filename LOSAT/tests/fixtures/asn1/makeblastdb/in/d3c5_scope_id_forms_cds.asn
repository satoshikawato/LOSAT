            { data biosrc { org { taxname "Escherichia coli" } }, location int { from 0, to 29, id genbank { accession "AB001123", version 1 } } }
          } } }
        },
        seq {
          id { genbank { accession "BAA00123", version 1 } },
          descr { molinfo { biomol peptide } },
          inst { repr raw, mol aa, length 10, seq-data ncbieaa "MKKKKKKKKK" },
          annot { { data ftable {
            { data prot { name { "probe protein 123" } }, location whole genbank { accession "BAA00123", version 1 } }
          } } }
        }
      }
    }
  }
}
