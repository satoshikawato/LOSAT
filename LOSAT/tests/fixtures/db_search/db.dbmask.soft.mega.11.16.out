<BlastOutput2>
  <report>
    <Report>
      <program>blastn</program>
      <version>BLASTN 2.17.0+</version>
      <reference>Zheng Zhang, Scott Schwartz, Lukas Wagner, and Webb Miller (2000), &quot;A greedy algorithm for aligning DNA sequences&quot;, J Comput Biol 2000; 7(1-2):203-14.</reference>
      <search-target>
        <Target>
          <db>tests/db_search/dbmask/a5</db>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <expect>10</expect>
          <sc-match>1</sc-match>
          <sc-mismatch>-2</sc-mismatch>
          <gap-open>0</gap-open>
          <gap-extend>0</gap-extend>
          <filter>L;m;</filter>
        </Parameters>
      </params>
      <results>
        <Results>
          <search>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>q1</query-title>
              <query-len>900</query-len>
              <query-masking>
                <Range>
                  <from>400</from>
                  <to>499</to>
                </Range>
              </query-masking>
              <hits>
                <Hit>
                  <num>1</num>
                  <description>
                    <HitDescr>
                      <id>gnl|BL_ORD_ID|0</id>
                      <accession>0</accession>
                      <title>s1 test subject s1</title>
                    </HitDescr>
                  </description>
                  <len>3000</len>
                  <hsps>
                    <Hsp>
                      <num>1</num>
                      <bit-score>1519.07</bit-score>
                      <score>822</score>
                      <evalue>0</evalue>
                      <identity>874</identity>
                      <query-from>1</query-from>
                      <query-to>900</query-to>
                      <query-strand>Plus</query-strand>
                      <hit-from>601</hit-from>
                      <hit-to>1500</hit-to>
                      <hit-strand>Plus</hit-strand>
                      <align-len>900</align-len>
                      <gaps>0</gaps>
                      <qseq></qseq>
                      <hseq></hseq>
                      <midline>||| |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||| | ||||||||||||||||||||||||||||||||||||||||||||| ||||||| ||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||| |||||||||||| |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||| ||||||||||||||||||||||||||||||||||||||||||||||||| ||||||||||||||||| |||||||||| |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||| |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||| |||||||||||||||| ||||||||||||||||||||||| ||||||||||||||||||||||||||||||||||||||||||||||||||||| |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||| ||||||||||||||||| ||||||||||||||||||||||||||||||||||| |||||||||||||||||||||||| |||||| ||||||| |||||| |||||||||||||||||||||||||||||||||| ||||||||| |||||||||||||||||| |||||||||||||||||||||||||||||</midline>
                    </Hsp>
                  </hsps>
                </Hit>
              </hits>
              <stat>
                <Statistics>
                  <db-num>5</db-num>
                  <db-len>7360</db-len>
                  <hsp-len>15</hsp-len>
                  <eff-space>6447225</eff-space>
                  <kappa>0.46</kappa>
                  <lambda>1.28</lambda>
                  <entropy>0.85</entropy>
                </Statistics>
              </stat>
            </Search>
          </search>
        </Results>
