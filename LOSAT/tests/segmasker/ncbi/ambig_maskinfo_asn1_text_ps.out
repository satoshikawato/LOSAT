Blast-db-mask-info ::= {
  algo-id 1,
  algo-program seg,
  algo-options "window=12; locut=2.2; hicut=2.5",
  masks {
    masks {
      int {
        from 72,
        to 91,
        id local str "amb1"
      },
      packed-int {
        {
          from 20,
          to 35,
          id local str "amb2"
        },
        {
          from 66,
          to 77,
          id local str "amb2"
        }
      },
      int {
        from 15,
        to 31,
        id local str "amb3"
      },
      int {
        from 23,
        to 41,
        id local str "amb4"
      },
      int {
        from 76,
        to 93,
        id local str "amb5"
      }
    },
    more FALSE
  }
}
