Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "plain",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">qinv invalid letters"
                  }
                }
              },
              title "qinv invalid letters"
            },
            inst {
              repr raw,
              mol aa,
              length 60,
              seq-data ncbieaa "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
XXXXXXXXXXXXXX"
            }
          }
        }
      },
      subject database "tests/db_search/x16_taxid",
      algorithm-options {
        {
          name "EvalueThreshold",
          value cutoff e-value { 1, 10, 1 }
        },
        {
          name "MaskAtHash",
          value boolean FALSE
        },
        {
          name "SegFiltering",
          value boolean FALSE
        },
        {
          name "WordThreshold",
          value integer 11
        },
        {
          name "WindowSize",
          value integer 40
        },
        {
          name "HitlistSize",
          value integer 500
        },
        {
          name "UngappedMode",
          value boolean TRUE
        },
        {
          name "CompositionBasedStats",
          value integer 0
        },
        {
          name "SmithWatermanMode",
          value boolean TRUE
        }
      }
    }
  },
  results {
    alignments {
    },
    masks {
    },
    ka-blocks {
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped FALSE
      },
      {
        lambda { -1, 10, 0 },
        k { -1, 10, 0 },
        h { -1, 10, 0 },
        gapped TRUE
      }
    },
    search-stats {
      "Effective search space: 0",
      "Effective search space used: 0",
      "Length adjustment: 0"
    }
  }
}
