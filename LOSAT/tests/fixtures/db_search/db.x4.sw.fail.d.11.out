Blast4-archive ::= {
  request {
    ident "2.17.0+",
    body queue-search {
      program "blastp",
      service "plain",
      queries bioseq-set {
        seq-set {
          seq {
            id {
              local str "Query_1"
            },
            descr {
              user {
                type str "CFastaReader",
                data {
                  {
                    label str "DefLine",
                    data str ">qok1 BDT63546.1 with W first"
                  }
                }
              },
              title "qok1 BDT63546.1 with W first"
            },
            inst {
              repr raw,
              mol aa,
              length 124,
              seq-data ncbieaa "WATAPAALPFGKANAAACGNSNNTFDVLEGLVKRARVVLVFITALS
IGLIVVAIMNLRMGMGNSAQGVPLLDEHGQPVLDGNDDPQIEEPNNTYPNKTRDYLILMASILSFVIGAASSYTTRLK"
            }
          }
        }
      },
      subject sequences {
        {
          id {
            local str "Subject_1"
          },
          descr {
            user {
              type str "CFastaReader",
              data {
                {
                  label str "DefLine",
                  data str ">sfail tks_M with D first, twice: two HSPs with
 tks_W, W against D"
                }
              }
            },
            title "sfail tks_M with D first, twice: two HSPs with tks_W, W
 against D"
          },
