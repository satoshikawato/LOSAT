Seq-entry ::= seq {
  id { local str "s1" },
  descr {
    title "t"
  },
  inst { repr raw, mol dna, length 120, seq-data iupacna "ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT" },
  annot { { data ftable {
    { data imp { key "misc_feature" }, location bond { a { point 5, id local str "X" }, b { point 7, id local str "s1" } } }
  } } }
}
