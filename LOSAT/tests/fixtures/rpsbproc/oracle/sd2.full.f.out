1	Query_1	Specific	380562	258	667	7.97852e-75	244.102	cd06339	PBP1_YraM_LppC_lipoprotein-like	-	530412
ENDDOMAINS
SUPERFAMILIES
1	Query_1	Superfamily	0	258	667	7.97852e-75	244.102	cl10011	Periplasmic_Binding_Protein_type1	-	-
ENDSUPERFAMILIES
ENDQUERY
