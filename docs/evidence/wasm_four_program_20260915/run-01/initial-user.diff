+        let mut score_gap_row = GAP_MININT;
+        let mut last_b_index = first_b_index;
+
+        let score_ptr = score_array.as_mut_ptr();
+        // NCBI reference: ncbi-blast/c++/src/algo/blast/core/blast_gapalign.c:563-665
