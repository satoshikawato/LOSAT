-    let max_len = len1.max(len2);
-    let mut max_dist = GREEDY_MAX_COST.min(max_len / GREEDY_MAX_COST_FRACTION + 1);
-
-    // Retry with doubled max_dist until convergence (NCBI BLAST approach)
