1	Query_1	Specific	513744	306	428	2.2919e-36	129.694	pfam00782	DSPc	-	531719
1	Query_1	Specific	214551	299	430	7.20422e-36	128.94	smart00195	DSPc	-	531719
1	Query_1	Specific	239481	47	197	9.57818e-33	122.036	cd03386	PAP2_Aur1_like	-	529117
1	Query_1	Specific	441989	306	430	9.62303e-28	106.979	COG2453	CDC14	-	-
ENDDOMAINS
SUPERFAMILIES
1	Query_1	Superfamily	0	295	429	3.06789e-55	179.393	cl28904	PTP_DSP_cys	-	-
1	Query_1	Superfamily	0	47	197	9.57818e-33	122.036	cl00474	PAP2_like	-	-
ENDSUPERFAMILIES
ENDQUERY
ENDSESSION	1
ENDDATA
