+fn create_hsplist_heap(lists: &mut [BlastnHspList]) {
+    let nel = lists.len();
+    if nel < 2 {
+        return;
+    }
+    let mut i = nel / 2;
+    while i > 0 {
+        i -= 1;
+        heapify_hsplist_array(lists, i, nel - 1);
+    }
