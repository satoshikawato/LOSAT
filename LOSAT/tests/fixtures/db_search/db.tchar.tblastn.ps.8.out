Seq-annot ::= {
  desc {
    user {
      type str "Hist Seqalign",
      data {
        {
          label str "Hist Seqalign",
          data bool TRUE
        }
      }
    },
    user {
      type str "Blast Type",
      data {
        {
          label str "tblastn",
          data int 4
        }
      }
    },
    user {
      type str "Blast Database Title",
      data {
        {
          label str "tc_ps_n",
          data bool TRUE
        }
      }
    }
  },
  data align {
    {
      type partial,
      dim 2,
      score {
        {
          id str "score",
          value int 320
        },
        {
          id str "blast_score",
          value int 320
        },
        {
          id str "e_value",
          value real { 419083457809252, 10, -60 }
        },
        {
          id str "bit_score",
          value real { 127872096573597, 10, -12 }
        },
        {
          id str "num_ident",
          value int 60
        },
        {
          id str "comp_adjustment_method",
          value int 2
        },
        {
          id str "num_positives",
          value int 60
        },
        {
          id str "hsp_percent_coverage",
          value real { 1, 10, 2 }
        }
      },
      segs std {
        {
          dim 2,
          ids {
            local str "Query_1",
            local str "ps1"
          },
          loc {
            int {
              from 0,
              to 59,
              strand unknown,
              id local str "Query_1"
            },
            int {
              from 0,
              to 179,
              strand plus,
              id local str "ps1"
            }
          }
        }
      }
    }
  }
}
