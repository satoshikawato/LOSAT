                  <db-len>66738</db-len>
                  <hsp-len>0</hsp-len>
                  <eff-space>0</eff-space>
                  <kappa>-1</kappa>
                  <lambda>-1</lambda>
                  <entropy>-1</entropy>
                </Statistics>
              </stat>
              <message>Query_1 YP_009220601.1 TK.. :  Query_1 YP_009220601.1 TK.. : Matrix PAM250 not allowed in PHI-BLAST&#xa;  No hits found &#xa;No hits found</message>
            </Search>
