Seq-entry ::= seq {
  id { local str "s1" },
  descr {
    title "t"
  },
  inst { repr raw, mol dna, length 120, seq-data iupacna "ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT" },
  annot { { data ftable {
    { data imp { key "misc_feature" }, location mix { int { from 0, to 29, id local str "s1" }, empty local str "X" }, except-text "circular RNA" }
  } } }
}
