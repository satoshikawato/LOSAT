Blast-db-mask-info ::= {
  algo-id 1,
  algo-program seg,
  algo-options "window=12; locut=2.2; hicut=2.5",
  masks {
    masks {
      int {
        from 72,
        to 91,
        id general {
          db "BL_ORD_ID",
          tag id 0
        }
      },
      packed-int {
        {
          from 20,
          to 35,
          id general {
            db "BL_ORD_ID",
            tag id 1
          }
        },
        {
          from 66,
          to 77,
          id general {
            db "BL_ORD_ID",
            tag id 1
          }
        }
      },
      int {
        from 15,
        to 31,
        id general {
          db "BL_ORD_ID",
          tag id 2
        }
      },
      int {
        from 23,
        to 41,
        id general {
          db "BL_ORD_ID",
          tag id 3
        }
      },
      int {
        from 76,
        to 93,
        id general {
          db "BL_ORD_ID",
          tag id 4
        }
      }
    },
    more FALSE
  }
}
