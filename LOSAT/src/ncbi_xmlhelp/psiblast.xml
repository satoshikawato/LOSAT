<?xml version="1.0"?>
<ncbi_application xmlns="ncbi:application"
 xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
 xs:schemaLocation="ncbi:application ncbi_application.xsd"
>
<program type="regular">
<name>psiblast</name>
<version>2.17.0</version>
<description>Position-Specific Iterated BLAST 2.17.0+</description>
<detailed_description></detailed_description>
</program>
<arguments>
<key name="best_hit_overhang" type="Real" optional="true">
<description>Best Hit algorithm overhang value (recommended value: 0.1)</description>
<group>7</group>
<synopsis>float_value</synopsis>
<constraint>
<description>(&gt;0 and &lt;0.5)</description>
</constraint>
</key>
<key name="best_hit_score_edge" type="Real" optional="true">
<description>Best Hit algorithm score edge value (recommended value: 0.1)</description>
<group>7</group>
<synopsis>float_value</synopsis>
<constraint>
<description>(&gt;0 and &lt;0.5)</description>
</constraint>
</key>
<key name="comp_based_stats" type="String" optional="true">
<description>Use composition-based statistics:&#xa;    D or d: default (equivalent to 2 )&#xa;    0 or F or f: No composition-based statistics&#xa;    1: Composition-based statistics as in NAR 29:2994-3005, 2001&#xa;    2 or T or t : Composition-based score adjustment as in Bioinformatics 21:902-911,&#xa;    2005, conditioned on sequence properties&#xa;    3: Composition-based score adjustment as in Bioinformatics 21:902-911,&#xa;    2005, unconditionally&#xa;</description>
<group>2</group>
<synopsis>compo</synopsis>
<default>2</default>
</key>
<key name="culling_limit" type="Integer" optional="true">
<description>If the query range of a hit is enveloped by that of at least this many higher-scoring hits, delete the hit</description>
<group>7</group>
<synopsis>int_value</synopsis>
<constraint>
<description>&gt;=0</description>
</constraint>
</key>
<key name="db" type="String" optional="true">
<description>BLAST database name</description>
<group>2</group>
<synopsis>database_name</synopsis>
</key>
<key name="dbsize" type="Int8" optional="true">
<description>Effective length of the database </description>
<group>9</group>
<synopsis>num_letters</synopsis>
</key>
<key name="entrez_query" type="String" optional="true">
<description>Restrict search with the given Entrez query</description>
<group>7</group>
<synopsis>entrez_query</synopsis>
</key>
<key name="evalue" type="Real" optional="true">
<description>Expectation value (E) threshold for saving hits. Default = 10</description>
<group>2</group>
<synopsis>evalue</synopsis>
</key>
<key name="export_search_strategy" type="File_Out" optional="true">
<description>File name to record the search strategy used</description>
<group>10</group>
<synopsis>filename</synopsis>
</key>
<key name="gap_trigger" type="Real" optional="true">
<description>Number of bits to trigger gapping</description>
<group>11</group>
<synopsis>float_value</synopsis>
<default>22</default>
</key>
<key name="gapextend" type="Integer" optional="true">
<description>Cost to extend a gap</description>
<group>2</group>
<synopsis>extend_penalty</synopsis>
</key>
<key name="gapopen" type="Integer" optional="true">
<description>Cost to open a gap</description>
<group>2</group>
<synopsis>open_penalty</synopsis>
</key>
<key name="gilist" type="String" optional="true">
<description>Restrict search of database to list of GIs</description>
<group>7</group>
<synopsis>filename</synopsis>
</key>
<key name="import_search_strategy" type="File_In" optional="true">
<description>Search strategy to use</description>
<group>10</group>
<synopsis>filename</synopsis>
</key>
<key name="in_msa" type="File_In" optional="true">
<description>File name of multiple sequence alignment to restart PSI-BLAST</description>
<group>14</group>
<synopsis>align_restart</synopsis>
</key>
<key name="in_pssm" type="File_In" optional="true">
<description>PSI-BLAST checkpoint file</description>
<group>14</group>
<synopsis>psi_chkpt_file</synopsis>
</key>
<key name="inclusion_ethresh" type="Real" optional="true">
<description>E-value inclusion threshold for pairwise alignments</description>
<group>14</group>
<synopsis>ethresh</synopsis>
<default>0.002</default>
</key>
<key name="ipglist" type="String" optional="true">
<description>Restrict search of database to list of IPGs</description>
<group>7</group>
<synopsis>filename</synopsis>
</key>
<key name="line_length" type="Integer" optional="true">
<description>Line length for formatting alignments&#xa;Not applicable for outfmt &gt; 4&#xa;Default = `60&apos;</description>
<group>5</group>
<synopsis>line_length</synopsis>
<constraint>
<description>&gt;=1</description>
</constraint>
</key>
<key name="matrix" type="String" optional="true">
<description>Scoring matrix name (normally BLOSUM62)</description>
<group>2</group>
<synopsis>matrix_name</synopsis>
</key>
<key name="max_hsps" type="Integer" optional="true">
<description>Set maximum number of HSPs per subject sequence to save for each query</description>
<group>7</group>
<synopsis>int_value</synopsis>
<constraint>
<description>&gt;=1</description>
</constraint>
</key>
<key name="max_target_seqs" type="Integer" optional="true">
<description>Maximum number of aligned sequences to keep &#xa;(value of 5 or more is recommended)&#xa;Default = `500&apos;</description>
<group>7</group>
<synopsis>num_sequences</synopsis>
<constraint>
<description>&gt;=1</description>
</constraint>
</key>
<key name="msa_master_idx" type="Integer" optional="true">
<description>Ordinal number (1-based index) of the sequence to use as a master in the multiple sequence alignment. If not provided, the first sequence in the multiple sequence alignment will be used</description>
<group>14</group>
<synopsis>index</synopsis>
<constraint>
<description>&gt;=1</description>
</constraint>
</key>
<key name="negative_gilist" type="String" optional="true">
<description>Restrict search of database to everything except the specified GIs</description>
<group>7</group>
<synopsis>filename</synopsis>
</key>
<key name="negative_ipglist" type="String" optional="true">
<description>Restrict search of database to everything except the specified IPGs</description>
<group>7</group>
<synopsis>filename</synopsis>
</key>
<key name="negative_seqidlist" type="String" optional="true">
<description>Restrict search of database to everything except the specified SeqIDs</description>
<group>7</group>
<synopsis>filename</synopsis>
</key>
<key name="negative_taxidlist" type="String" optional="true">
<description>Restrict search of database to everything except the specified taxonomy IDs and their descendants </description>
<group>7</group>
<synopsis>filename</synopsis>
</key>
<key name="negative_taxids" type="String" optional="true">
<description>Restrict search of database to everything except the specified taxonomy IDs and their descendants (multiple IDs delimited by &apos;,&apos;)</description>
<group>7</group>
<synopsis>taxids</synopsis>
</key>
<key name="num_alignments" type="Integer" optional="true">
<description>Number of database sequences to show alignments for&#xa;Default = `250&apos;</description>
<group>5</group>
<synopsis>int_value</synopsis>
<constraint>
<description>&gt;=0</description>
</constraint>
</key>
<key name="num_descriptions" type="Integer" optional="true">
<description>Number of database sequences to show one-line descriptions for&#xa;Not applicable for outfmt &gt; 4&#xa;Default = `500&apos;</description>
<group>5</group>
<synopsis>int_value</synopsis>
<constraint>
<description>&gt;=0</description>
</constraint>
</key>
<key name="num_iterations" type="Integer" optional="true">
<description>Number of iterations to perform (0 means run until convergence)</description>
<group>13</group>
<synopsis>int_value</synopsis>
<constraint>
<description>&gt;=0</description>
</constraint>
<default>1</default>
</key>
<key name="num_threads" type="Integer" optional="true">
<description>Number of threads (CPUs) to use in the BLAST search</description>
<group>12</group>
<synopsis>int_value</synopsis>
<constraint>
<description>&gt;=1</description>
</constraint>
<default>1</default>
</key>
<key name="out" type="File_Out" optional="true">
<description>Output file name</description>
<group>2</group>
<synopsis>output_file</synopsis>
<constraint>
<description>file name length &lt; 256</description>
</constraint>
<default>-</default>
</key>
<key name="out_ascii_pssm" type="File_Out" optional="true">
<description>File name to store ASCII version of PSSM</description>
<group>13</group>
<synopsis>ascii_mtx_file</synopsis>
</key>
<key name="out_pssm" type="File_Out" optional="true">
<description>File name to store checkpoint file</description>
<group>13</group>
<synopsis>checkpoint_file</synopsis>
</key>
<key name="outfmt" type="String" optional="true">
<description>alignment view options:&#xa;  0 = Pairwise,&#xa;  1 = Query-anchored showing identities,&#xa;  2 = Query-anchored no identities,&#xa;  3 = Flat query-anchored showing identities,&#xa;  4 = Flat query-anchored no identities,&#xa;  5 = BLAST XML,&#xa;  6 = Tabular,&#xa;  7 = Tabular with comment lines,&#xa;  8 = Seqalign (Text ASN.1),&#xa;  9 = Seqalign (Binary ASN.1),&#xa; 10 = Comma-separated values,&#xa; 11 = BLAST archive (ASN.1),&#xa; 12 = Seqalign (JSON),&#xa; 13 = Multiple-file BLAST JSON,&#xa; 14 = Multiple-file BLAST XML2,&#xa; 15 = Single-file BLAST JSON,&#xa; 16 = Single-file BLAST XML2,&#xa; 18 = Organism Report,&#xa; 20 = Comma-separated values with header lines&#xa;&#xa;Options 6, 7, 10 and 20 can be additionally configured to produce&#xa;a custom format specified by space delimited format specifiers,&#xa;or by a token specified by the delim keyword.&#xa; E.g.: &quot;10 delim=@ qacc sacc score&quot;.&#xa;The delim keyword must appear after the numeric output format&#xa;specification.&#xa;The supported format specifiers are:&#xa;&#x9;    qseqid means Query Seq-id&#xa;&#x9;       qgi means Query GI&#xa;&#x9;      qacc means Query accession&#xa;&#x9;   qaccver means Query accession.version&#xa;&#x9;      qlen means Query sequence length&#xa;&#x9;    sseqid means Subject Seq-id&#xa;&#x9; sallseqid means All subject Seq-id(s), separated by a &apos;;&apos;&#xa;&#x9;       sgi means Subject GI&#xa;&#x9;    sallgi means All subject GIs&#xa;&#x9;      sacc means Subject accession&#xa;&#x9;   saccver means Subject accession.version&#xa;&#x9;   sallacc means All subject accessions&#xa;&#x9;      slen means Subject sequence length&#xa;&#x9;    qstart means Start of alignment in query&#xa;&#x9;      qend means End of alignment in query&#xa;&#x9;    sstart means Start of alignment in subject&#xa;&#x9;      send means End of alignment in subject&#xa;&#x9;      qseq means Aligned part of query sequence&#xa;&#x9;      sseq means Aligned part of subject sequence&#xa;&#x9;    evalue means Expect value&#xa;&#x9;  bitscore means Bit score&#xa;&#x9;     score means Raw score&#xa;&#x9;    length means Alignment length&#xa;&#x9;    pident means Percentage of identical matches&#xa;&#x9;    nident means Number of identical matches&#xa;&#x9;  mismatch means Number of mismatches&#xa;&#x9;  positive means Number of positive-scoring matches&#xa;&#x9;   gapopen means Number of gap openings&#xa;&#x9;      gaps means Total number of gaps&#xa;&#x9;      ppos means Percentage of positive-scoring matches&#xa;&#x9;    frames means Query and subject frames separated by a &apos;/&apos;&#xa;&#x9;    qframe means Query frame&#xa;&#x9;    sframe means Subject frame&#xa;&#x9;      btop means Blast traceback operations (BTOP)&#xa;&#x9;    staxid means Subject Taxonomy ID&#xa;&#x9;  ssciname means Subject Scientific Name&#xa;&#x9;  scomname means Subject Common Name&#xa;&#x9;sblastname means Subject Blast Name&#xa;&#x9; sskingdom means Subject Super Kingdom&#xa;&#x9;   staxids means unique Subject Taxonomy ID(s), separated by a &apos;;&apos;&#xa;&#x9;&#x9;&#x9; (in numerical order)&#xa;&#x9; sscinames means unique Subject Scientific Name(s), separated by a &apos;;&apos;&#xa;&#x9; scomnames means unique Subject Common Name(s), separated by a &apos;;&apos;&#xa;&#x9;sblastnames means unique Subject Blast Name(s), separated by a &apos;;&apos;&#xa;&#x9;&#x9;&#x9; (in alphabetical order)&#xa;&#x9;sskingdoms means unique Subject Super Kingdom(s), separated by a &apos;;&apos;&#xa;&#x9;&#x9;&#x9; (in alphabetical order) &#xa;&#x9;    stitle means Subject Title&#xa;&#x9;salltitles means All Subject Title(s), separated by a &apos;&lt;&gt;&apos;&#xa;&#x9;   sstrand means Subject Strand&#xa;&#x9;     qcovs means Query Coverage Per Subject&#xa;&#x9;   qcovhsp means Query Coverage Per HSP&#xa;&#x9;    qcovus means Query Coverage Per Unique Subject (blastn only)&#xa;When not provided, the default value is:&#xa;&apos;qaccver saccver pident length mismatch gapopen qstart qend sstart send evalue bitscore&apos;, which is equivalent to the keyword &apos;std&apos;&#xa;</description>
<group>5</group>
<synopsis>format</synopsis>
<default>0</default>
</key>
<key name="phi_pattern" type="File_In" optional="true">
<description>File name containing pattern to search</description>
<group>15</group>
<synopsis>file</synopsis>
</key>
<key name="pseudocount" type="Integer" optional="true">
<description>Pseudo-count value used when constructing PSSM</description>
<group>14</group>
<synopsis>pseudocount</synopsis>
<default>0</default>
</key>
<key name="qcov_hsp_perc" type="Real" optional="true">
<description>Percent query coverage per hsp</description>
<group>7</group>
<synopsis>float_value</synopsis>
<constraint>
<description>0..100</description>
<Doubles>
<min>0</min>
<max>100</max>
</Doubles>
</constraint>
</key>
<key name="query" type="File_In" optional="true">
<description>Input file name</description>
<group>1</group>
<synopsis>input_file</synopsis>
<default>-</default>
</key>
<key name="query_loc" type="String" optional="true">
<description>Location on the query sequence in 1-based offsets (Format: start-stop)</description>
<group>1</group>
<synopsis>range</synopsis>
</key>
<key name="searchsp" type="Int8" optional="true">
<description>Effective length of the search space</description>
<group>9</group>
<synopsis>int_value</synopsis>
<constraint>
<description>&gt;=0</description>
</constraint>
</key>
<key name="seg" type="String" optional="true">
<description>Filter query sequence with SEG (Format: &apos;yes&apos;, &apos;window locut hicut&apos;, or &apos;no&apos; to disable)</description>
<group>6</group>
<synopsis>SEG_options</synopsis>
<default>no</default>
</key>
<key name="seqidlist" type="String" optional="true">
<description>Restrict search of database to list of SeqIDs</description>
<group>7</group>
<synopsis>filename</synopsis>
</key>
<key name="soft_masking" type="Boolean" optional="true">
<description>Apply filtering locations as soft masks</description>
<group>6</group>
<synopsis>soft_masking</synopsis>
<default>false</default>
</key>
<key name="sorthits" type="Integer" optional="true">
<description>Sorting option for hits:&#xa;alignment view options:&#xa;  0 = Sort by evalue,&#xa;  1 = Sort by bit score,&#xa;  2 = Sort by total score,&#xa;  3 = Sort by percent identity,&#xa;  4 = Sort by query coverage&#xa;Not applicable for outfmt &gt; 4&#xa;</description>
<group>5</group>
<synopsis>sort_hits</synopsis>
<constraint>
<description>(&gt;=0 and =&lt;4)</description>
</constraint>
</key>
<key name="sorthsps" type="Integer" optional="true">
<description>Sorting option for hps:&#xa;  0 = Sort by hsp evalue,&#xa;  1 = Sort by hsp score,&#xa;  2 = Sort by hsp query start,&#xa;  3 = Sort by hsp percent identity,&#xa;  4 = Sort by hsp subject start&#xa;Not applicable for outfmt != 0&#xa;</description>
<group>5</group>
<synopsis>sort_hsps</synopsis>
<constraint>
<description>(&gt;=0 and =&lt;4)</description>
</constraint>
</key>
<key name="subject" type="File_In" optional="true">
<description>Subject sequence(s) to search</description>
<group>4</group>
<synopsis>subject_input_file</synopsis>
</key>
<key name="subject_loc" type="String" optional="true">
<description>Location on the subject sequence in 1-based offsets (Format: start-stop)</description>
<group>4</group>
<synopsis>range</synopsis>
</key>
<key name="sum_stats" type="Boolean" optional="true">
<description>Use sum statistics</description>
<group>9</group>
<synopsis>bool_value</synopsis>
</key>
<key name="taxidlist" type="String" optional="true">
<description>Restrict search of database to include only the specified taxonomy IDs and their descendants </description>
<group>7</group>
<synopsis>filename</synopsis>
</key>
<key name="taxids" type="String" optional="true">
<description>Restrict search of database to include only the specified taxonomy IDs and their descendants (multiple IDs delimited by &apos;,&apos;)</description>
<group>7</group>
<synopsis>taxids</synopsis>
</key>
<key name="threshold" type="Real" optional="true">
<description>Minimum word score such that the word is added to the BLAST lookup table</description>
<group>2</group>
<synopsis>float_value</synopsis>
<constraint>
<description>&gt;=0</description>
</constraint>
</key>
<key name="window_size" type="Integer" optional="true">
<description>Multiple hits window size, use 0 to specify 1-hit algorithm</description>
<group>11</group>
<synopsis>int_value</synopsis>
<constraint>
<description>&gt;=0</description>
</constraint>
</key>
<key name="word_size" type="Integer" optional="true">
<description>Word size for wordfinder algorithm</description>
<group>2</group>
<synopsis>int_value</synopsis>
<constraint>
<description>&gt;=2</description>
</constraint>
</key>
<key name="xdrop_gap" type="Real" optional="true">
<description>X-dropoff value (in bits) for preliminary gapped extensions</description>
<group>11</group>
<synopsis>float_value</synopsis>
</key>
<key name="xdrop_gap_final" type="Real" optional="true">
<description>X-dropoff value (in bits) for final gapped alignment</description>
<group>11</group>
<synopsis>float_value</synopsis>
</key>
<key name="xdrop_ungap" type="Real" optional="true">
<description>X-dropoff value (in bits) for ungapped extensions</description>
<group>11</group>
<synopsis>float_value</synopsis>
</key>
<flag name="h" optional="true">
<description>Print USAGE and DESCRIPTION;  ignore all other parameters</description>
</flag>
<flag name="help" optional="true">
<description>Print USAGE, DESCRIPTION and ARGUMENTS; ignore all other parameters</description>
</flag>
<flag name="html" optional="true">
<description>Produce HTML output?</description>
<group>5</group>
</flag>
<flag name="ignore_msa_master" optional="true">
<description>Ignore the master sequence when creating PSSM</description>
<group>14</group>
</flag>
<flag name="lcase_masking" optional="true">
<description>Use lower case filtering in query and subject sequence(s)?</description>
<group>6</group>
</flag>
<flag name="no_taxid_expansion" optional="true">
<description>Do not expand the taxonomy IDs provided to their descendant taxonomy IDs </description>
<group>7</group>
</flag>
<flag name="parse_deflines" optional="true">
<description>Should the query and subject defline(s) be parsed?</description>
<group>12</group>
</flag>
<flag name="remote" optional="true">
<description>Execute search remotely?</description>
<group>12</group>
</flag>
<flag name="save_each_pssm" optional="true">
<description>Save PSSM after each iteration (file name is given in -save_pssm or -save_ascii_pssm options)</description>
<group>13</group>
</flag>
<flag name="save_pssm_after_last_round" optional="true">
<description>Save PSSM after the last database search</description>
<group>13</group>
</flag>
<flag name="show_gis" optional="true">
<description>Show NCBI GIs in deflines?</description>
<group>5</group>
</flag>
<flag name="subject_besthit" optional="true">
<description>Return only the best HSP for each non overlapping query region</description>
<group>7</group>
</flag>
<flag name="use_sw_tback" optional="true">
<description>Compute locally optimal Smith-Waterman alignments?</description>
<group>12</group>
</flag>
<flag name="version" optional="true">
<description>Print version number;  ignore other arguments</description>
</flag>
