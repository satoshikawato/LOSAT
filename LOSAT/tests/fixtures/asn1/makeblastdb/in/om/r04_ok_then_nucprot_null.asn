Seq-entry ::= seq {
  id { local str "s1" },
  descr {
    title "t"
  },
  inst { repr raw, mol dna, length 120, seq-data iupacna "ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT" }
}

Seq-entry ::= set {
  class nuc-prot,
  descr { NULL, user { type str "Unverified", data { { label str "Type", data str "Organism" } } } },
  seq-set {
    seq { id { local str "s7" }, descr { title "t" }, inst { repr raw, mol dna, length 4, seq-data iupacna "ACGT" } }
  }
}
