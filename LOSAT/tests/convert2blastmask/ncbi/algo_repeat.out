Blast-db-mask-info ::= {
  algo-id 0,
  algo-program repeat,
  algo-options "o",
  masks {
    masks {
      packed-int {
        {
          from 4,
          to 7,
          id local id 1
        },
        {
          from 16,
          to 19,
          id local id 1
        },
        {
          from 24,
          to 27,
          id local id 1
        }
      },
      int {
        from 0,
        to 7,
        id local id 3
      }
    },
    more FALSE
  }
}
