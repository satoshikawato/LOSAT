<?xml version="1.0" encoding="US-ASCII"?>
<BlastXML2
    xmlns="http://www.ncbi.nlm.nih.gov"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
    xs:schemaLocation="http://www.ncbi.nlm.nih.gov http://www.ncbi.nlm.nih.gov/data_specs/schema_alt/NCBI_BlastOutput2.xsd"
>
<BlastOutput2>
  <report>
    <Report>
      <program>blastn</program>
      <version>BLASTN 2.17.0+</version>
      <reference>Stephen F. Altschul, Thomas L. Madden, Alejandro A. Sch&amp;auml;ffer, Jinghui Zhang, Zheng Zhang, Webb Miller, and David J. Lipman (1997), &quot;Gapped BLAST and PSI-BLAST: a new generation of protein database search programs&quot;, Nucleic Acids Res. 25:3389-3402.</reference>
      <search-target>
        <Target>
          <subjects>Subject_1</subjects>
        </Target>
      </search-target>
      <params>
        <Parameters>
          <expect>10</expect>
          <sc-match>2</sc-match>
          <sc-mismatch>-3</sc-mismatch>
          <gap-open>5</gap-open>
          <gap-extend>2</gap-extend>
          <filter>L;</filter>
        </Parameters>
      </params>
      <results>
        <Results>
          <bl2seq>
            <Search>
              <query-id>Query_1</query-id>
              <query-title>q_mask query with lowercase runs and a CA-repeat block</query-title>
              <query-len>400</query-len>
              <query-masking>
                <Range>
                  <from>168</from>
                  <to>217</to>
                </Range>
              </query-masking>
              <hits>
                <Hit>
                  <num>1</num>
                  <description>
                    <HitDescr>
                      <id>subj_mask</id>
                      <title>subj_mask subject with a CA-repeat low-complexity block</title>
                    </HitDescr>
                  </description>
                  <len>500</len>
                  <hsps>
                    <Hsp>
                      <num>1</num>
                      <bit-score>528.772</bit-score>
                      <score>585</score>
                      <evalue>2.35803e-154</evalue>
                      <identity>397</identity>
                      <query-from>1</query-from>
                      <query-to>400</query-to>
                      <query-strand>Plus</query-strand>
                      <hit-from>51</hit-from>
                      <hit-to>450</hit-to>
                      <hit-strand>Plus</hit-strand>
                      <align-len>400</align-len>
                      <gaps>0</gaps>
                      <qseq></qseq>
                      <hseq></hseq>
                      <midline>|||||||||||||||||||||||||||||| ||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||| |||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||| ||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||</midline>
                    </Hsp>
                  </hsps>
                </Hit>
              </hits>
              <stat>
                <Statistics>
                  <hsp-len>12</hsp-len>
                  <eff-space>189344</eff-space>
                  <kappa>0.41</kappa>
                  <lambda>0.625</lambda>
                  <entropy>0.78</entropy>
                </Statistics>
              </stat>
            </Search>
          </bl2seq>
        </Results>
      </results>
    </Report>
  </report>
</BlastOutput2>
</BlastXML2>
