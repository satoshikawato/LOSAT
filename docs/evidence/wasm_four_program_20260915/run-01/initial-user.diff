+    //     best_q_start = current_q_start;
+    //     best_s_start = current_s_start;
+    //     best_q_end = query;
+    //     best_s_end = subject;
+    //     best_start_esp_index = current_start_esp_index;
+    //     best_end_esp_index = index;
+    //     best_end_esp_num = op_index;
