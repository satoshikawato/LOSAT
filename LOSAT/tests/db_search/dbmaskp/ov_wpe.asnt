Blast-db-mask-info ::= {
  algo-id 2,
  algo-program seg,
  algo-options "overlap wpe",
  masks {
    masks {
      packed-int {
        {
          from 10,
          to 59,
          id local id 1
        },
        {
          from 20,
          to 98,
          id local id 1
        },
        {
          from 30,
          to 39,
          id local id 1
        }
      }
    },
    more FALSE
  }
}
