{
  "name": "losat-web",
  "version": "0.0.0",
  "private": true,
  "description": "LOSAT Web: in-browser local sequence search (see docs/losat_web_gui_plan.md).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run check -w losat && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "losat": "0.2.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
