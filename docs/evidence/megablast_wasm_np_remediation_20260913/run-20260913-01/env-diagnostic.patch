+// NCBI reference: c++/src/algo/blast/core/blast_engine.c:1659-1668
+// /* Use a local diagnostics structure ... shared between multiple threads */
+// Isolated diagnostic only; nested work durations are not additive wall time.
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+static NS: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+static CALLS: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+pub struct Scope { id: usize, start: Instant }
+impl Scope { pub fn new(id: usize) -> Self { Self { id, start: Instant::now() } } }
+impl Drop for Scope { fn drop(&mut self) {
+    NS[self.id].fetch_add(self.start.elapsed().as_nanos() as u64, Relaxed);
+    CALLS[self.id].fetch_add(1, Relaxed);
+} }
+pub fn var(key: &str) -> Result<String, std::env::VarError> {
+    let _scope = Scope::new(0); std::env::var(key)
+}
+pub fn var_os(key: &str) -> Option<std::ffi::OsString> {
+    let _scope = Scope::new(0); std::env::var_os(key)
+}
+pub struct Report;
+impl Drop for Report { fn drop(&mut self) {
+    for (i, name) in ["n_gapped_env", "n_packed_kernel", "n_trace_forward", "n_trace_reverse", "n_trace_wrapper"].iter().enumerate() {
+        eprintln!("[ENV_COST] name={} calls={} aggregate_ns={}", name, CALLS[i].load(Relaxed), NS[i].load(Relaxed));
+    }
+} }
