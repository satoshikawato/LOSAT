+                };
+                let hit = &group_hits[idx];
+                let link = &pool_hsp_links[idx];
+                format!(
+                    "idx={} raw={} num0={} sum0={} xsum0={:.6e} num1={} sum1={} xsum1={:.6e} q_aa={}..{} s_aa={}..{} q_frame={} s_frame={}",
+                    idx,
+                    hit.raw_score,
+                    link.num[0],
+                    link.sum[0],
+                    link.xsum[0],
+                    link.num[1],
+                    link.sum[1],
+                    link.xsum[1],
