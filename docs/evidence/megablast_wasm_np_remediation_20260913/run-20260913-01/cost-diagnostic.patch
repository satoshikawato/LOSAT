+static NS:[AtomicU64;3]=[const {AtomicU64::new(0)};3];
+static CALLS:[AtomicU64;3]=[const {AtomicU64::new(0)};3];
+static CELLS:[AtomicU64;3]=[const {AtomicU64::new(0)};3];
+static ROWS:[AtomicU64;3]=[const {AtomicU64::new(0)};3];
+pub struct Scope { pub id:usize, pub cells:u64, pub rows:u64, start:Instant }
+impl Scope {pub fn new(id:usize)->Self {Self{id,cells:0,rows:0,start:Instant::now()}}}
