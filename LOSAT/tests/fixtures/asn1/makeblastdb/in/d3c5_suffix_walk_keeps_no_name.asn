Bioseq-set ::= {
  class genbank,
  seq-set {
    seq {
      id { genbank { accession "AB009400", version 1 } },
      descr { title "htgs delta", molinfo { biomol genomic, tech standard }, genbank { keywords { "UNORDERED" } } },
      inst { repr delta, mol dna, length 30, ext delta { loc whole prf { accession "PRF1119" }, literal { length 10 }, literal { length 10, seq-data iupacna "ACGTACGTAC" } } }
    },
    seq {
      id { local str "Z" },
      descr { title "z", molinfo { biomol genomic } },
      inst { repr ref, mol dna, length 10, ext ref int { from 0, to 9, id prf { name "OTHERPRF", accession "PRF2000" } } }
    },
    set {
      class nuc-prot,
      seq-set {
        seq {
          id { prf { name "PRF1119" } },
          descr { title "nuc 119", molinfo { biomol genomic } },
          inst { repr raw, mol dna, length 30, seq-data iupacna "CGCACGCTTCAGAGCATGCCTCATGAGCGG" },
          annot { { data ftable {
            { data cdregion { frame one }, product whole genbank { accession "BAA00119", version 1 }, location int { from 2, to 20, id prf { accession "PRF1119" } } },
            { data biosrc { org { taxname "Escherichia coli" } }, location int { from 0, to 29, id prf { name "PRF1119" } } }
          } } }
        },
        seq {
          id { genbank { accession "BAA00119", version 1 } },
          descr { molinfo { biomol peptide } },
          inst { repr raw, mol aa, length 10, seq-data ncbieaa "MKKKKKKKKK" },
          annot { { data ftable {
            { data prot { name { "probe protein 119" } }, location whole genbank { accession "BAA00119", version 1 } }
          } } }
        }
      }
    }
  }
}
