Seq-annot ::= {
  desc {
    user {
      type str "Hist Seqalign",
      data {
        {
          label str "Hist Seqalign",
          data bool TRUE
        }
      }
    },
    user {
      type str "Blast Type",
      data {
        {
          label str "blastx",
          data int 3
        }
      }
    },
    user {
      type str "Blast Database Title",
      data {
        {
          label str "n/a",
          data bool FALSE
        }
      }
    }
  },
  data align {
    {
      type diags,
      segs std {
        {
          dim 2,
          ids {
            local str "Query_1",
            local str "Subject_1"
          },
          loc {
            int {
              from 13,
              to 12,
              strand minus,
              id local str "Query_1"
            },
            int {
              from 2,
              to 1,
              strand unknown,
              id local str "Subject_1"
            }
          },
          scores {
            {
              id str "score",
              value int 3
            },
            {
              id str "blast_score",
              value int 3
            },
            {
              id str "e_value",
              value real { 372009404945472, 10, -14 }
            },
            {
              id str "bit_score",
              value real { 423394392169587, 10, -14 }
            },
            {
              id str "num_ident",
              value int 0
            },
            {
              id str "hsp_percent_coverage",
              value real { 5, 10, -1 }
            }
          }
        }
      }
    }
  }
}
