Blast-db-mask-info ::= {
  algo-id 2,
  algo-program windowmasker,
  algo-options "hedge3 s1200",
  masks {
    masks {
      packed-int {
        {
          from 300,
          to 399,
          id local id 2
        },
        {
          from 1200,
          to 1201,
          id local id 2
        }
      }
    },
    more FALSE
  }
}
