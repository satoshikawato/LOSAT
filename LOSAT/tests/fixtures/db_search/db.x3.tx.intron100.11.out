Blast4-archive ::= {
  request {
    body get-request-info {
      request-id "Error"
    }
  },
  results {
  },
  messages {
    {
      code 2,
      message "BLAST query/options error: Uneven gap linking of HSPs is
 allowed for blastx, tblastn, and psitblastn only"
    },
    {
      code 2,
      message "Please refer to the BLAST+ user manual."
    }
  }
}
