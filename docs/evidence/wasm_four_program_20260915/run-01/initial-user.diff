+/// Scratch space for greedy gapped alignment (traceback + affine DP arrays).
+/// NCBI reference: ncbi-blast/c++/src/algo/blast/core/blast_gapalign.c:356-357
+/// ```c
+/// gap_align->fwd_prelim_tback = GapPrelimEditBlockNew();
