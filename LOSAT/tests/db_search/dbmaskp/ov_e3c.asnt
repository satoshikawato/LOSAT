Blast-db-mask-info ::= {
  algo-id 2,
  algo-program seg,
  algo-options "overlap e3c",
  masks {
    masks {
      packed-int {
        {
          from 40,
          to 59,
          id local id 1
        },
        {
          from 60,
          to 69,
          id local id 1
        }
      }
    },
    more FALSE
  }
}
