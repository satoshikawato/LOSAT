            seq-data ncbieaa "MATAPAALPFGKANAAACGNSNNTFDVLEGLVKRARVVLVFITALSIG
LIVVAIMNLRMGMGNSAQGVPLLDEHGQPVLDGNDDPQIEEPNNTYPNKTRDYLILMASILSFVIGAASSYTTRLK"
          }
        }
      },
      algorithm-options {
