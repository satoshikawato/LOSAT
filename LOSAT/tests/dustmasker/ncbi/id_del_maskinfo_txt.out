Blast-db-mask-info ::= {
  algo-id 2,
  algo-program dust,
  algo-options "window=64; level=20; linker=1",
  masks {
    masks {
      packed-int {
        {
          from 0,
          to 60,
          id local str "a#b"
        },
        {
          from 100,
          to 159,
          id local str "a#b"
        }
      }
    },
    more FALSE
  }
}
